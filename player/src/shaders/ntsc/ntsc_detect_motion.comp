#version 450

#include "muse.h"

// Per-pixel motion mask for the still/moving combine, invoked twice with
// global invocation ids from (0, 0) until (NTSC_Y_BUF_WIDTH,
// NTSC_FIELD_HEIGHT * 2): phase 1 computes the raw motion value, phase 2
// dilates it and applies a decaying temporal persistence.
//
// Motion is measured on the composite frame history.  The subcarrier phase
// inverts from one frame to the next (227.5 cycles per line), so a plain
// adjacent-frame difference of still colored content is twice the chroma,
// not zero.  Two differences avoid that trap:
//  - frame0 vs frame2: two frames apart the phase realigns, so the full-band
//    difference is valid everywhere (but reacts a frame late),
//  - frame0 vs frame1 through an 8-sample box: on the 4 fsc grid the box has
//    nulls at fsc and its harmonics, cancelling the still-chroma term and
//    leaving low-frequency luma motion with single-frame latency.
// Comparing rows of the same frame index also means comparing fields of the
// same parity, so still vertical detail (which differs between the two
// interlaced fields) never registers as motion.

layout(push_constant) uniform PushConstants {
    uint processing_phase;
    uint use_prev_movement; // 0 on the first frame and after a seek
    float motion_none;      // difference at or below this is considered noise
    float motion_full;      // difference at which the pixel is fully moving
};

layout(set = 0, binding = 0) buffer readonly restrict frame0_buffer {
    float16_t frame0[][NTSC_TOTAL_WIDTH]; // the latest frame
};

layout(set = 0, binding = 1) buffer readonly restrict frame1_buffer {
    float16_t frame1[][NTSC_TOTAL_WIDTH]; // one frame back
};

layout(set = 0, binding = 2) buffer readonly restrict frame2_buffer {
    float16_t frame2[][NTSC_TOTAL_WIDTH]; // two frames back
};

layout(set = 0, binding = 3) buffer restrict raw_motion_buffer {
    float16_t raw_motion[][NTSC_Y_BUF_WIDTH]; // phase 1 output
};

layout(set = 0, binding = 4) buffer readonly restrict prev_movement_buffer {
    float16_t prev_movement[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 5) buffer writeonly restrict movement_out_buffer {
    float16_t movement_out[][NTSC_Y_BUF_WIDTH]; // values between 0 and 1
};

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;

    if (row >= NTSC_FIELD_HEIGHT * 2 || col >= NTSC_Y_BUF_WIDTH)
        return;

    if (processing_phase == 1) {
        // Even output rows hold the first field, odd rows the second; same
        // mapping as the single-field decode.
        uint line = 22 + row / 2 + ((row & 1u) != 0u ? 263u : 0u);
        uint x = col + NTSC_FIELD_START_X;

        float d02 = abs(float(frame0[line][x]) - float(frame2[line][x]));

        float d01 = 0.0;
        for (int i = -4; i < 4; i++) {
            uint xx = uint(clamp(int(x) + i, 0, NTSC_TOTAL_WIDTH - 1));
            d01 += float(frame0[line][xx]) - float(frame1[line][xx]);
        }
        d01 = abs(d01) * 0.125;

        // Edges shimmer slightly with sampling jitter even when still, so
        // raise the thresholds with the local gradient.  The vertical
        // neighbours are the same field's adjacent lines (lines of one field
        // are contiguous in the frame buffer).
        float eh = abs(float(frame0[line][min(x + 2, NTSC_TOTAL_WIDTH - 1)])
                       - float(frame0[line][max(int(x) - 2, 0)]));
        float ev = abs(float(frame0[min(line + 1, NTSC_TOTAL_HEIGHT - 1)][x])
                       - float(frame0[max(int(line) - 1, 0)][x]));
        float edge = max(eh, ev);

        float diff = max(d02, d01);
        float none = motion_none + 0.05 * edge;
        float full = motion_full + 0.25 * edge;
        raw_motion[row][col] = float16_t(clamp((diff - none) / (full - none), 0.0, 1.0));
    } else {
        // Dilate so the blend covers the surroundings of whatever moved, and
        // keep a decaying memory of previous motion: a pixel that just
        // stopped still has a stale opposite field to weave for one frame.
        float m = 0.0;
        for (int dr = -1; dr <= 1; dr++)
            for (int dc = -2; dc <= 2; dc++) {
                uint r = uint(clamp(int(row) + dr, 0, NTSC_FIELD_HEIGHT * 2 - 1));
                uint c = uint(clamp(int(col) + dc, 0, NTSC_Y_BUF_WIDTH - 1));
                m = max(m, float(raw_motion[r][c]));
            }
        if (use_prev_movement != 0)
            m = max(m, 0.5 * float(prev_movement[row][col]));
        movement_out[row][col] = float16_t(m);
    }
}
