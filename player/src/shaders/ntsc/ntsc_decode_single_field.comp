#version 450

// This shader should be invoked with global invocation ids
// from (0, 0) until (NTSC_Y_BUF_WIDTH, NTSC_FIELD_HEIGHT).

#include "muse.h"

layout(push_constant) uniform PushConstants {
    uint field_parity;
    uint dropout_mode; // 0: normal, 1: disabled, 2: highlight
    uint use_3d_comb;  // 0 forces the spatial comb everywhere (key 4 / --no-3d-comb)
    float rot_re;
    float rot_im;
    float level_floor;   // below this, picture luma is considered illegal
    float level_ceiling; // likewise above this; both computed in NtscDecoder
                         // from the measured blanking level and noise
    float chroma_sel_floor; // noise floor for the spatial/temporal comb
                            // selector, scaled from the measured sigma
};

layout(set = 0, binding = 0) buffer readonly input_frame_buffer {
    float16_t input_frame[][NTSC_TOTAL_WIDTH];
};

layout(set = 0, binding = 1) buffer readonly color_burst_phase_data_buffer {
    f16vec2 phase_data[];
};

layout(set = 0, binding = 2) buffer writeonly Y_data_buffer {
    float16_t Y_data[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 3) buffer writeonly r_data_buffer {
    float16_t U_data[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 4) buffer writeonly b_data_buffer {
    float16_t V_data[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 5) buffer readonly dropout_data_buffer {
    uint8_t dropout_data[][NTSC_TOTAL_WIDTH];
};

layout(set = 0, binding = 6) buffer readonly prev_frame_buffer {
    float16_t prev_frame[][NTSC_TOTAL_WIDTH]; // composite of frame N-1
};

layout(set = 0, binding = 7) buffer readonly next_frame_buffer {
    float16_t next_frame[][NTSC_TOTAL_WIDTH]; // composite of frame N+1 (lookahead)
};

// Directional motion masks from ntsc_detect_motion.comp, frame-row indexed
layout(set = 0, binding = 8) buffer readonly past_motion_buffer {
    float16_t past_motion[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 9) buffer readonly future_motion_buffer {
    float16_t future_motion[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 10) buffer readonly prev_burst_phase_buffer {
    f16vec2 prev_phase_data[]; // per-line burst of frame N-1
};

layout(set = 0, binding = 11) buffer readonly next_burst_phase_buffer {
    f16vec2 next_phase_data[]; // per-line burst of frame N+1
};

layout(set = 0, binding = 12) buffer readonly prev_dropout_buffer {
    uint8_t prev_dropout[][NTSC_TOTAL_WIDTH];
};

layout(set = 0, binding = 13) buffer readonly next_dropout_buffer {
    uint8_t next_dropout[][NTSC_TOTAL_WIDTH];
};

float16_t cosine_lut[] = { 1.hf, 0.hf, -1.hf, 0.hf };
float16_t sine_lut[] = { 0.hf, 1.hf, 0.hf, -1.hf };

float16_t color_cosine(uint col) {
    return cosine_lut[col % 4];
}

float16_t color_sine(uint col) {
    return sine_lut[col % 4];
}

// Post-demodulation chroma lowpass: 19-tap Hamming-windowed sinc, 1.0 MHz
// cutoff on the 4 fsc grid (-60 dB at fsc, -52 dB at the 2 fsc demodulation
// image).  Applied to the raw demodulation products, it also interpolates the
// missing quadrature: at 4 fsc each sample carries only one of them.
const float16_t chroma_lowpass[19] = float16_t[](
    -0.00218987hf, -0.00165572hf, 0.00063727hf, 0.00857601hf, 0.02546721hf,
    0.05192392hf, 0.08466937hf, 0.11698703hf, 0.14079925hf, 0.14957109hf,
    0.14079925hf, 0.11698703hf, 0.08466937hf, 0.05192392hf, 0.02546721hf,
    0.00857601hf, 0.00063727hf, -0.00165572hf, -0.00218987hf);

// 3-line comb Y/C separation: the same-field adjacent lines are 180 degrees
// apart in subcarrier phase.  It beat 1D notch/bandpass separation clearly in
// an A/B comparison (both halves of the picture, three captures): both its Y
// and C paths carry about 4 dB less noise, at the price of some vertical
// resolution.
float16_t chroma_sample(uint frame_line, uint next_line, uint fcol) {
    return -0.25hf * input_frame[frame_line - 1][fcol]
           + 0.5hf * input_frame[frame_line][fcol]
           - 0.25hf * input_frame[next_line][fcol];
}

float16_t comb_luma(uint frame_line, uint next_line, uint frame_col) {
    return 0.25hf * input_frame[frame_line - 1][frame_col]
           + 0.5hf * input_frame[frame_line][frame_col]
           + 0.25hf * input_frame[next_line][frame_col];
}

// Comb and chroma taps on the neighbour frames, for temporal dropout
// concealment: a still neighbour's same pixel is a far better donor than
// the surrounding lines.  The donor's chroma is demodulated against its own
// frame's burst reference, which absorbs the frame-to-frame subcarrier
// inversion and the sampling phase jitter in one step.
float16_t chroma_sample_prev(uint fl, uint nl, uint fc) {
    return -0.25hf * prev_frame[fl - 1][fc] + 0.5hf * prev_frame[fl][fc] - 0.25hf * prev_frame[nl][fc];
}

float16_t comb_luma_prev(uint fl, uint nl, uint fc) {
    return 0.25hf * prev_frame[fl - 1][fc] + 0.5hf * prev_frame[fl][fc] + 0.25hf * prev_frame[nl][fc];
}

float16_t chroma_sample_next(uint fl, uint nl, uint fc) {
    return -0.25hf * next_frame[fl - 1][fc] + 0.5hf * next_frame[fl][fc] - 0.25hf * next_frame[nl][fc];
}

float16_t comb_luma_next(uint fl, uint nl, uint fc) {
    return 0.25hf * next_frame[fl - 1][fc] + 0.5hf * next_frame[fl][fc] + 0.25hf * next_frame[nl][fc];
}

// Sampling phase correction for the temporal pairs: the DPLL grid jitters a
// few degrees of subcarrier line to line (the sync loop must stay wide to
// track player wow, so this floor cannot be tuned away), and the pair
// difference (f0 - fneighbour)/2 comes out as the chroma rotated by half the
// lines' phase offset.  The offset is measured exactly by the two lines' own
// colour bursts: e^(-j delta) = -b_n conj(b_0) / |...|, and the estimate is
// de-rotated by delta/2 using the one-sample-shift quadrature, which is
// exact at fsc on the 4 fsc grid.  Returns (cos, sin) of delta/2.
f16vec2 pair_rotation(f16vec2 bn, f16vec2 b0) {
    float rx = float(bn.x) * float(b0.x) + float(bn.y) * float(b0.y);
    float ry = float(bn.y) * float(b0.x) - float(bn.x) * float(b0.y);
    float m = sqrt(rx * rx + ry * ry);
    if (m < 1e-4)
        return f16vec2(1.hf, 0.hf); // no usable burst on one of the lines
    float cd = -rx / m;
    float sd = ry / m;
    float ch = sqrt(max(0.5 * (1.0 + cd), 0.0));
    float sh = (sd >= 0.0 ? 1.0 : -1.0) * sqrt(max(0.5 * (1.0 - cd), 0.0));
    return f16vec2(float16_t(ch), float16_t(sh));
}

// Interpolate two rotations: the grid phase is continuous in scan time, so
// between this line's burst and the next line's burst the phase offset
// drifts linearly, and the correction at a column is the interpolation of
// the two measurements.  Without it the correction is exact at the burst and
// decays across the line (measured: half the artifact left at the far edge).
f16vec2 lerp_rotation(f16vec2 a, f16vec2 b, float t) {
    vec2 v = mix(vec2(a), vec2(b), t);
    float l = max(length(v), 1e-4);
    return f16vec2(v / l);
}

float16_t rotated_prev_pair(uint fl, uint fc, f16vec2 r) {
    float16_t c0 = 0.5hf * (input_frame[fl][fc] - prev_frame[fl][fc]);
    float16_t cm = 0.5hf * (input_frame[fl][fc - 1] - prev_frame[fl][fc - 1]);
    float16_t cp = 0.5hf * (input_frame[fl][fc + 1] - prev_frame[fl][fc + 1]);
    return c0 * r.x + 0.5hf * (cm - cp) * r.y;
}

float16_t rotated_next_pair(uint fl, uint fc, f16vec2 r) {
    float16_t c0 = 0.5hf * (input_frame[fl][fc] - next_frame[fl][fc]);
    float16_t cm = 0.5hf * (input_frame[fl][fc - 1] - next_frame[fl][fc - 1]);
    float16_t cp = 0.5hf * (input_frame[fl][fc + 1] - next_frame[fl][fc + 1]);
    return c0 * r.x + 0.5hf * (cm - cp) * r.y;
}

// The absolute burst reference drifts across the line for the same reason
// the pair rotations do, so interpolate it per column between this line's
// burst and the next line's (structural 180 removed).  The magnitudes carry
// the burst-referenced AGC gain, so the plain complex lerp interpolates the
// gain alongside the phase (the chord shortening is negligible at these
// angles).  Fall back to the line's own burst when the neighbour is
// achromatic or implausibly far off: a dropout through the burst window, or
// the clamped last line, where the "neighbour" is the line itself and the
// negation lands 180 degrees away.
f16vec2 interpolated_burst(f16vec2 b0, f16vec2 b1, float t) {
    vec2 v0 = vec2(b0);
    vec2 v1 = -vec2(b1); // adjacent lines are 180 degrees apart
    float g0 = dot(v0, v0);
    float g1 = dot(v1, v1);
    if (g0 < 1e-4 || g1 < 1e-4 || dot(v0, v1) < 0.5 * sqrt(g0 * g1))
        return b0;
    return f16vec2(mix(v0, v1, t));
}



// The spatial and temporal estimates fail differently: the spatial comb
// leaks vertical luma detail (and hanging-dot errors at horizontal chroma
// edges) into its estimate but is exact on vertically uniform content,
// while the temporal estimate is blind to vertical detail but carries the
// residue of frame-to-frame sampling phase jitter (a few degrees of
// subcarrier), which shimmers on saturated flat areas.  Where the picture
// is vertically uniform the two estimates agree to within that jitter
// residue -- which scales with the chroma envelope -- so a disagreement
// beyond a few % of the envelope (and above the noise floor) is the spatial
// comb's leak, and only then is the temporal estimate worth its jitter.
float16_t temporal_weight(const float16_t cs[19], const float16_t ct[19]) {
    float16_t e_s = 0.hf;
    float16_t d = 0.hf;
    for (int n = 0; n < 19; n++) {
        e_s += abs(cs[n]);
        d += abs(cs[n] - ct[n]);
    }
    float16_t floor_ = float16_t(chroma_sel_floor);
    return clamp((d - 0.02hf * e_s - floor_) / (0.2hf * e_s + floor_), 0.hf, 1.hf);
}

f16vec2 demodulated_chroma(const float16_t c_src[19], uint frame_col) {
    float16_t c_re = 0.hf;
    float16_t c_im = 0.hf;
    for (int n = 0; n < 19; n++) {
        uint fc = uint(int(frame_col) + n - 9);
        float16_t cs = 2.hf * c_src[n];
        c_re += chroma_lowpass[n] * cs * color_cosine(fc);
        c_im += chroma_lowpass[n] * cs * color_sine(fc);
    }
    return f16vec2(c_re, c_im);
}

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;

    if (row >= NTSC_FIELD_HEIGHT || col >= NTSC_Y_BUF_WIDTH)
        return;

    uint frame_line = 22 + row + 263 * field_parity;
    uint frame_col = col + NTSC_FIELD_START_X;
    uint mask_row = row * 2 + field_parity;

    // the comb degrades to two lines on the frame's last line
    uint next_line = min(frame_line + 1, NTSC_TOTAL_HEIGHT - 1);

    float16_t Y = comb_luma(frame_line, next_line, frame_col);
    bool painted = false;
    bool rescued = false;

    // Illegal-level rescue: picture luma below blanking level, or far above
    // white, is illegal -- short dropouts that keep a healthy-looking
    // envelope often land there.  Substitute the nearest line with the same
    // subcarrier phase.  (The envelope-detected dropouts are concealed
    // upstream in the copy shader; this catches what that detector cannot
    // see.)  Requiring three of five neighbouring samples outside the bounds
    // keeps the test blind both to the subcarrier-rate ringing that
    // saturated chroma edges leave in the comb luma and to noise around the
    // blanking level, so the floor can sit tight; a sustained spot passes.
    int outside = 0;
    for (int dx = -2; dx <= 2; dx++) {
        float16_t y = dx == 0 ? Y : comb_luma(frame_line, next_line, uint(int(frame_col) + dx));
        outside += (y < float16_t(level_floor) || y > float16_t(level_ceiling)) ? 1 : 0;
    }
    // An illegal level at a pixel the motion masks call still is picture
    // content, not a dropout: real dropout garbage deviates from the
    // neighbouring frames and registers as motion.  This keeps the sporadic
    // threshold flicker on high-contrast static detail (subtitle strokes
    // overshoot the ceiling on noise) from being "rescued" into smear.
    float16_t motion_here = max(past_motion[mask_row][col], future_motion[mask_row][col]);
    if (dropout_mode != 1 && outside >= 3 && motion_here > 0.1hf) {
        if (dropout_mode == 2) {
            painted = true;
        } else {
            for (int k = 2; k <= 8; k += 2) {
                uint fl = uint(clamp(int(frame_line) - k, 22, NTSC_TOTAL_HEIGHT - 1));
                float16_t y2 = comb_luma(fl, fl + 1, frame_col);
                if (y2 < float16_t(level_floor) || y2 > float16_t(level_ceiling)) {
                    fl = uint(clamp(int(frame_line) + k, 22, NTSC_TOTAL_HEIGHT - 1));
                    y2 = comb_luma(fl, fl + 1, frame_col);
                }
                if (y2 >= float16_t(level_floor) && y2 <= float16_t(level_ceiling)) {
                    Y = y2;
                    frame_line = fl;
                    next_line = min(fl + 1, NTSC_TOTAL_HEIGHT - 1);
                    rescued = true;
                    break;
                }
            }
        }
    }

    // The temporal paths only apply to healthy pixels: concealed or rescued
    // composite has no valid history in the neighbouring frames.
    bool own_flagged = dropout_data[frame_line][frame_col] != 0;
    bool temporal = use_3d_comb != 0 && !rescued && !own_flagged;

    // Temporal dropout concealment: for a flagged pixel whose surroundings
    // are still, the same pixel of the stiller neighbour frame is a far
    // better donor than the upstream line average.  The donor is decoded
    // in place (its own comb taps and its own burst reference); a side is
    // refused when its motion mask says the content moved or its own
    // dropout plane flags the same spot, and with both sides refused the
    // line-average concealment stands.
    int donor = 0; // 0: none, -1: previous frame, +1: next frame
    if (dropout_mode == 0 && !rescued && own_flagged && motion_here > 0.1hf) {
        float16_t mp = past_motion[mask_row][col];
        float16_t mf = future_motion[mask_row][col];
        for (int attempt = 0; attempt < 2 && donor == 0; attempt++) {
            bool try_prev = (mp <= mf) == (attempt == 0);
            if ((try_prev ? mp : mf) > 0.5hf)
                continue;
            if ((try_prev ? prev_dropout[frame_line][frame_col] : next_dropout[frame_line][frame_col]) != 0)
                continue;
            donor = try_prev ? -1 : 1;
        }
    }

    // Gather both chroma estimates over the demodulation window and blend by
    // the envelope comparison (the temporal candidates are already
    // motion-gated per column, so a moving column degenerates to spatial and
    // pulls the weight down with it).
    float16_t c_src[19];
    float t_burst = clamp((float(frame_col) - 94.0) / 910.0, 0.0, 1.0); // burst sits at ~column 94
    f16vec2 burst_ref = interpolated_burst(phase_data[frame_line], phase_data[next_line], t_burst);
    if (donor != 0) {
        for (int n = 0; n < 19; n++) {
            uint fc = uint(int(frame_col) + n - 9);
            c_src[n] = donor < 0 ? chroma_sample_prev(frame_line, next_line, fc)
                                 : chroma_sample_next(frame_line, next_line, fc);
        }
        Y = donor < 0 ? comb_luma_prev(frame_line, next_line, frame_col)
                      : comb_luma_next(frame_line, next_line, frame_col);
        burst_ref = donor < 0 ? interpolated_burst(prev_phase_data[frame_line], prev_phase_data[next_line], t_burst)
                              : interpolated_burst(next_phase_data[frame_line], next_phase_data[next_line], t_burst);
    } else if (temporal) {
        f16vec2 rot_p0 = pair_rotation(prev_phase_data[frame_line], phase_data[frame_line]);
        f16vec2 rot_n0 = pair_rotation(next_phase_data[frame_line], phase_data[frame_line]);
        uint nl = row + 1 < NTSC_FIELD_HEIGHT ? frame_line + 1 : frame_line;
        f16vec2 rot_p1 = pair_rotation(prev_phase_data[nl], phase_data[nl]);
        f16vec2 rot_n1 = pair_rotation(next_phase_data[nl], phase_data[nl]);
        // 3D comb: the subcarrier inverts between adjacent frames, so for
        // still content the temporal pair differences are pure modulated
        // chroma, with no vertical resolution cost and full-bandwidth luma.
        // The directional motion masks blend each column between the still
        // temporal neighbours (both sides -> symmetric 3-tap, one side ->
        // that frame pair) and the spatial comb where the picture moves.
        // The selector, though, judges the ungated temporal estimate: the
        // masks answer whether temporal data is safe, the selector whether
        // it is worth anything -- feeding it the gated blend would let a
        // half-raised mask erase the disagreement it needs to see.
        float16_t cs_arr[19], ct_arr[19], pure_arr[19];
        for (int n = 0; n < 19; n++) {
            uint fc = uint(int(frame_col) + n - 9);
            cs_arr[n] = chroma_sample(frame_line, next_line, fc);
            float t = clamp((float(fc) - 94.0) / 910.0, 0.0, 1.0); // burst sits at ~column 94
            float16_t rp = rotated_prev_pair(frame_line, fc, lerp_rotation(rot_p0, rot_p1, t));
            float16_t rn = rotated_next_pair(frame_line, fc, lerp_rotation(rot_n0, rot_n1, t));
            pure_arr[n] = 0.5hf * (rp + rn);
            uint mc = uint(clamp(int(fc) - NTSC_FIELD_START_X, 0, NTSC_Y_BUF_WIDTH - 1));
            float16_t wp = 1.hf - past_motion[mask_row][mc];
            float16_t wf = 1.hf - future_motion[mask_row][mc];
            float16_t sm = max(wp, wf);
            ct_arr[n] = sm <= 0.hf ? cs_arr[n]
                      : mix(cs_arr[n], (wp * rp + wf * rn) / (wp + wf), sm);
        }
        float16_t w_t = temporal_weight(cs_arr, pure_arr);
        for (int n = 0; n < 19; n++)
            c_src[n] = mix(cs_arr[n], ct_arr[n], w_t);

        // Luma follows the same blend.  The temporal estimate is bandpassed
        // around fsc before the subtraction (samples 2 apart on the 4 fsc
        // grid are 180 degrees of subcarrier): still chroma passes in full,
        // but low-frequency residue of sub-threshold motion or lighting
        // flicker cancels, so it cannot ghost into the luma.  At w_t = 0
        // this is exactly the classic 3-line comb luma, so vertically
        // uniform content is untouched by the 3D path.
        float16_t ct_band = 0.5hf * ct_arr[9] - 0.25hf * (ct_arr[7] + ct_arr[11]);
        float16_t f0 = input_frame[frame_line][frame_col];
        Y = f0 - mix(cs_arr[9], ct_band, w_t);
    } else {
        for (int n = 0; n < 19; n++)
            c_src[n] = chroma_sample(frame_line, next_line, uint(int(frame_col) + n - 9));
    }

    f16vec2 c_demod = demodulated_chroma(c_src, frame_col);
    float16_t c_re = c_demod.x;
    float16_t c_im = c_demod.y;

    // rotate the c vector by the conjugate of the burst reference, which also
    // carries the burst-referenced gain (a + ib)(c + id) = ac-bd + i(bc+ad)

    float16_t b_re = burst_ref.x;
    float16_t b_im = burst_ref.y;

    float16_t I = c_re * b_re + c_im * b_im;
    float16_t Q = c_im * b_re - c_re * b_im;

    // As arranged below, the transform computes U + jV = e^(ja) conj(I + jQ)
    // with a = atan2(rot_re, rot_im): the conjugation reconciles the phase
    // direction of the sine LUT with the subcarrier's, and the angle folds
    // together the structural 180 degrees, the calibrated offset, and the
    // --tint option; --saturation scales the magnitude.  The values are
    // computed in NtscDecoder.
    float16_t V = I * float16_t(rot_re) - Q * float16_t(rot_im);
    float16_t U = Q * float16_t(rot_re) + I * float16_t(rot_im);

    if (dropout_mode == 2 && (painted || (dropout_data[frame_line][frame_col] != 0 && motion_here > 0.1hf))) {
        // paint detected dropouts pure red (inverts through the RGB matrix
        // in the combine shader to (1, 0, 0))
        Y = 0.299hf;
        U = -0.14714hf;
        V = 0.61497hf;
    }

    Y_data[row][col] = Y;
    U_data[row][col] = U;
    V_data[row][col] = V;
}
