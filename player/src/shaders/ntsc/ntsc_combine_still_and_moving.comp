#version 450

#include "muse.h"

// This shader should be invoked with global invocation ids
// from (0, 0) until (NTSC_Y_BUF_WIDTH, NTSC_FIELD_HEIGHT * 2)

layout(push_constant) uniform PushConstants {
    // both set to 1 makes no sense
    uint force_field_only;  // bob: interpolate everything from the current field
    uint force_weave_only;  // weave: always take the missing rows from the previous field
    int field_parity;       // parity of the current field: 0 owns even output rows, 1 odd
    uint output_yuv;
};

// The decoded fields, one buffer set per parity.  The set of the current
// field's parity was just decoded; the other set still holds the previous
// (opposite-parity) field, which is what the still parts weave in.
layout(set = 0, binding = 0) buffer readonly restrict field0_Y_buffer {
    float16_t field0_Y[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 1) buffer readonly restrict field0_U_buffer {
    float16_t field0_U[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 2) buffer readonly restrict field0_V_buffer {
    float16_t field0_V[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 3) buffer readonly restrict field1_Y_buffer {
    float16_t field1_Y[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 4) buffer readonly restrict field1_U_buffer {
    float16_t field1_U[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 5) buffer readonly restrict field1_V_buffer {
    float16_t field1_V[][NTSC_Y_BUF_WIDTH];
};

// Directional motion masks: past covers motion before the displayed frame's
// fields were captured, future motion after (from the lookahead frame)
layout(set = 0, binding = 6) buffer readonly restrict past_movement_buffer {
    float16_t past_movement[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 7) buffer readonly restrict future_movement_buffer {
    float16_t future_movement[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D frame_out_image;

layout(set = 0, binding = 9) buffer writeonly frame_out_y_buffer {
    uint16_t frame_out_Y[][NTSC_Y_BUF_WIDTH];
};

layout(set = 0, binding = 10) buffer writeonly frame_out_u_buffer {
    uint16_t frame_out_U[][NTSC_Y_BUF_WIDTH / 2];
};

layout(set = 0, binding = 11) buffer writeonly frame_out_v_buffer {
    uint16_t frame_out_V[][NTSC_Y_BUF_WIDTH / 2];
};

f16vec3 currentField(uint i, uint col) {
    return field_parity == 0 ? f16vec3(field0_Y[i][col], field0_U[i][col], field0_V[i][col])
                             : f16vec3(field1_Y[i][col], field1_U[i][col], field1_V[i][col]);
}

f16vec3 previousField(uint i, uint col) {
    return field_parity == 0 ? f16vec3(field1_Y[i][col], field1_U[i][col], field1_V[i][col])
                             : f16vec3(field0_Y[i][col], field0_U[i][col], field0_V[i][col]);
}

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;

    if (row >= NTSC_FIELD_HEIGHT * 2 || col >= NTSC_Y_BUF_WIDTH)
        return;

    f16vec3 yuv;
    if (int(row & 1u) == field_parity) {
        // A row the current field sampled: use it directly
        yuv = currentField(row / 2, col);
    } else {
        // A row the current field did not sample.  Where the picture is
        // still, the previous field's row (which sits exactly here) is the
        // real thing; where it moves, that row is 1/60 s stale and would
        // comb, so interpolate the current field's neighbours instead.
        uint n0 = row / 2;
        uint n1 = uint(clamp(int(row / 2) + (field_parity == 0 ? 1 : -1), 0, NTSC_FIELD_HEIGHT - 1));
        f16vec3 bob = 0.5hf * (currentField(n0, col) + currentField(n1, col));
        f16vec3 weave = previousField(row / 2, col);
        // Each field consults the evidence window that brackets its weave:
        // field 0 weaves the previous frame's field 1, whose staleness
        // interval lies in the past window; field 1 weaves this frame's
        // field 0, whose staleness interval [field 0, field 1] is only
        // covered by the lookahead differences.
        float16_t m = force_field_only != 0 ? 1.hf
                    : force_weave_only != 0 ? 0.hf
                    : field_parity == 0 ? past_movement[row][col]
                                        : future_movement[row][col];
        yuv = mix(weave, bob, m);
    }
    float16_t Y = yuv.x, U = yuv.y, V = yuv.z;
    Y = clamp(Y, 0.hf, 1.hf);
    U = clamp(U, -1.hf, 1.hf);
    V = clamp(V, -1.hf, 1.hf);

    float16_t r = Y + V * 1.139883hf;
    float16_t g = Y - U * 0.394642hf - V * 0.580622hf;
    float16_t b = Y + U * 2.032062hf;

    // r g b are the gamma-corrected studio signal (R'); apply the CRT EOTF to
    // get linear light for the sRGB swapchain, and convert the SMPTE C
    // primaries to sRGB -- the same display rendering as the MUSE path
    // (muse/combine_still_and_moving.comp), except that NTSC carries the
    // studio signal directly, with no transmission gamma to invert first.
    r = pow(clamp(r, 0.hf, 1.hf), 2.2hf);
    g = pow(clamp(g, 0.hf, 1.hf), 2.2hf);
    b = pow(clamp(b, 0.hf, 1.hf), 2.2hf);

    float16_t r2 =  9.3892e-01hf * r +  5.0196e-02hf * g + 1.0270e-02hf * b;
    float16_t g2 =  1.7760e-02hf * r +  9.6607e-01hf * g + 1.6424e-02hf * b;
    float16_t b2 = -1.6205e-03hf * r + -4.3710e-03hf * g + 1.0053e+00hf * b;

    imageStore(frame_out_image, ivec2(col, row), vec4(float(r2), float(g2), float(b2), 1.f));

    if (output_yuv != 0) {
        frame_out_Y[row][col] = uint16_t(clamp(Y * 256.hf, 0.hf, 255.hf) * 256.hf);
        if ((row & 1) == 0 && (col & 1) == 0) {
            // U and V carry modulation-scaled color differences (B-Y = 2.032062 U,
            // R-Y = 1.139883 V); rescale to full-range Cb = (B-Y)/1.772, Cr = (R-Y)/1.402
            float16_t Cb = U * 1.146757hf;
            float16_t Cr = V * 0.813040hf;
            frame_out_U[row / 2][col / 2] = uint16_t(clamp(Cb * 256.hf + 128.hf, 0.hf, 255.hf) * 256.hf);
            frame_out_V[row / 2][col / 2] = uint16_t(clamp(Cr * 256.hf + 128.hf, 0.hf, 255.hf) * 256.hf);
        }
    }
}
