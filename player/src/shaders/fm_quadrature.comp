#version 450

// This shader implements fm quadrature demodulation.
//
// The source analytic data will be indexed from 0 to size.
// The dest data will be indexed from output_offset up to output_offset + size - 1.
// As a by-product the squared envelope of analytic samples 1 to size is written to
// the envelope buffer (the sample pairs are loaded here anyway), for the dropout
// detector's envelope_box.comp and envelope_block_sums.comp.  Entry 0 of that buffer
// is the recycled previous sample and is maintained by the caller, like the analytic
// buffers themselves.
//
// For scale = 1, add = 0, the output will be between -1 and 1 if the
// frequency deviation is +/- frequency_deviation.
//
// The carrier is taken out before the phase is measured: the product of a
// sample and the conjugate of the previous one is rotated by
// carrier_rotation = e^{-j 2 pi center_frequency / sample_frequency} (a
// constant the caller computes), and the atan then gives the deviation from
// the carrier directly, unambiguous within +-sample_frequency / 2.  Taking the
// atan first and subtracting the carrier's phase step afterwards would wrap
// whenever that step plus the deviation passed pi, which it does when the
// analytic signal is decimated: at 31.25 MHz a 12.5 MHz carrier steps 2.51 rad
// per sample and the top of the MUSE band 4.48.
//
// That rotation also settles the wrapped step: a step of more than pi from the
// carrier reads as the frequency fs/2 further the other way, which happens without
// any dropout: on the Technidisc Star Wars capture the saturated
// green title text takes the carrier amplitude to a fifth of its local level for
// one sample once per chroma cycle (the lower chroma sideband at 7.5 - 3.6 MHz has
// largely left the passband), and the phase has to catch up there in one sample --
// usually by less than pi, a short spike towards white that the mean over the
// chroma cycle needs, now and then by more, and the wrapped step then read as
// -19.8 MHz: one raw sample that the video lowpass spread into a dark comet across
// ten columns of the picture, and the de-emphasis gave a tail.  A wrapped step is
// only known modulo 2 pi, and the two readings (as is, or plus the sample rate) are
// both spikes the lowpass spreads into the picture, one dark and one bright; the
// atan of the rotated product gives the one nearer the carrier, never further than
// half the sample rate from it, which is what the unwrap_below threshold of the
// earlier (atan, then subtract) form chose.  (ld-decode adds 2 pi to every negative
// step, and its brightest specks come from the readings near zero.)  Replacing the wrapped sample by a
// neighbour instead was tried and left half the hole: the phase it carried is
// real.  A real dropout is noise with steps in both directions, and stays noise
// for the dropout detector's slew test downstream.

#include "muse.h"

layout(push_constant) uniform PushConstants {
    float size;
    float output_offset;
    float sample_frequency;
    float frequency_deviation;
    float carrier_rotation_re;
    float carrier_rotation_im;
    float output_scale;
    float output_add;
    float unwrap_below; // fm_out below this is a wrapped step and gets 2 pi added
};

layout(set = 0, binding = 0) buffer readonly filter_buffer {
    float analytic_re[];
};

layout(set = 0, binding = 1) buffer readonly source_buffer {
    float analytic_im[];
};

layout(set = 0, binding = 2) buffer writeonly dest_buffer {
    float dest[];
};

layout(set = 0, binding = 3) buffer writeonly envelope_buffer {
    float envelope[];
};

const float c_pi = 3.14159265f;

void main() {
    uint ix = gl_GlobalInvocationID.x;

    if (ix >= uint(size))
        return;

    float prev_sample_re = analytic_re[ix];
    float prev_sample_im = analytic_im[ix];
    float sample_re = analytic_re[ix + 1];
    float sample_im = analytic_im[ix + 1];

    // compute prod = sample * conj(prev_sample);
    float prod_re = sample_re * prev_sample_re + sample_im * prev_sample_im;
    float prod_im = sample_re * -prev_sample_im + sample_im * prev_sample_re;

    // take the carrier out: prod *= carrier_rotation
    float rotated_re = prod_re * carrier_rotation_re - prod_im * carrier_rotation_im;
    float rotated_im = prod_re * carrier_rotation_im + prod_im * carrier_rotation_re;

    // arg(rotated): the phase step per sample relative to the carrier
    float phase_diff = atan(rotated_im, rotated_re);

    // fm_out will be in the range [-1, 1] when the frequency varies between center_frequency - frequency_deviation and center_frequency + frequency_deviation
    float fm_out = phase_diff * (sample_frequency / (2 * 3.14159265f * frequency_deviation));

    dest[ix + uint(output_offset)] = fm_out * output_scale + output_add;
    envelope[ix + 1] = sample_re * sample_re + sample_im * sample_im;
}
