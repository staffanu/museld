#version 450

// Squared envelope of the analytic signal, and its 9-sample box average,
// for every raw sample.  This is the pre-pass for the envelope dropout
// detector: it evaluates the local envelope at five positions per output
// sample (the sample and the same spot on four neighbouring lines), and
// computing the box average directly from the analytic buffers there cost
// 90 loads per output sample.  Here each raw sample costs 18 loads, and the
// detector then reads one value per position.
//
// It should be invoked with global invocation ids from 0 to size - 1, and
// clamps its window to that range the way the detector used to.

#include "muse.h"

layout(push_constant) uniform PushConstants {
    uint size;
};

layout(set = 0, binding = 0) buffer readonly analytic_re_buffer {
    float analytic_re[];
};

layout(set = 0, binding = 1) buffer readonly analytic_im_buffer {
    float analytic_im[];
};

layout(set = 0, binding = 2) buffer writeonly envelope_buffer {
    float envelope[];
};

layout(set = 0, binding = 3) buffer writeonly local_envelope_buffer {
    float local_envelope[];
};

float envelope_squared(int i) {
    i = clamp(i, 0, int(size) - 1);
    float re = analytic_re[i];
    float im = analytic_im[i];
    return re * re + im * im;
}

void main() {
    int ix = int(gl_GlobalInvocationID.x);

    if (ix >= int(size))
        return;

    // local envelope over ±4 raw samples, summed in the same order as the
    // detector used to so the flags stay identical
    float sum = 0.0;
    for (int k = -4; k <= 4; k++)
        sum += envelope_squared(ix + k);

    envelope[ix] = envelope_squared(ix);
    local_envelope[ix] = sum / 9.0;
}
