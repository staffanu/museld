#version 450

// Dropout concealment of the raw composite, the first half of what was
// sdtv_copy_to_frame.comp: the de-emphasis FIR that follows
// (sdtv_deemphasis.comp) read this concealed value at each of its 24 taps,
// so doing the concealment once per sample here instead of once per tap
// saves the flag and motion mask loads 24 times over.  The columns before
// the colour burst are replaced by blanking level here as well, see the
// comment at the end.
//
// This shader should be invoked with global invocation ids
// ranging from (0, 0) to (SDTV_TOTAL_WIDTH, SDTV_TOTAL_HEIGHT).

#include "muse.h"

layout(push_constant) uniform PushConstants {
    uint dropout_mode;  // 0: normal, 1: disabled, 2: highlight
    float level_offset; // measured blanking level in reader voltage units
};

layout(set = 0, binding = 0) buffer readonly frame_in_buffer {
    float frame_in[][SDTV_TOTAL_WIDTH];
};

// The extended dropout plane prepared by sdtv_extend_dropouts.comp (never
// flagged in the vertical interval).
layout(set = 0, binding = 1) buffer readonly dropout_data_buffer {
    uint8_t dropout_data[][SDTV_TOTAL_WIDTH];
};

layout(set = 0, binding = 2) buffer writeonly concealed_out_buffer {
    float concealed_out[][SDTV_TOTAL_WIDTH];
};

// Motion masks of the previous frame (this frame's are not computed yet);
// their future side covers the differences against this frame, which is
// exactly the evidence needed: a real dropout's garbage never matches the
// neighbouring frames, so it always registers as motion there, while a
// false detection on static content (subtitle strokes) shows none -- and
// concealing those from the surrounding lines damages the picture more
// than the marginal defect it was flagged for.
layout(set = 0, binding = 3) buffer readonly past_motion_buffer {
    float16_t past_motion[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 4) buffer readonly future_motion_buffer {
    float16_t future_motion[][SDTV_Y_BUF_WIDTH];
};

float motion_at(int r, int c) {
    int field = r >= SDTV_FIELD2_OFFSET ? 1 : 0;
    int fr = r - SDTV_FIELD_START_Y - SDTV_FIELD2_OFFSET * field;
    if (fr < 0 || fr >= SDTV_FIELD_HEIGHT)
        return 1.0; // outside the picture rows: keep the old behavior
    int orow = fr * 2 + field;
    int oc = clamp(c - SDTV_FIELD_START_X, 0, SDTV_Y_BUF_WIDTH - 1);
    return max(float(past_motion[orow][oc]), float(future_motion[orow][oc]));
}

bool is_dropout(int r, int c) {
    int cc = clamp(c, 0, SDTV_TOTAL_WIDTH - 1);
    // A flag without temporal deviation is content, not a dropout.  The gate
    // sits low: shallow real dropouts deviate modestly, while static content
    // (subtitle text) measures essentially zero.
    return dropout_data[r][cc] != 0 && motion_at(r, cc) > 0.1;
}

// Donor lines are only refused for core detections (1), not for the
// precautionary extension (2) around them.
bool is_core_dropout(int r, int c) {
    return dropout_data[r][clamp(c, 0, SDTV_TOTAL_WIDTH - 1)] == 1;
}

// Reads the raw composite with dropout concealment.  Concealment substitutes
// the nearest lines with the same subcarrier phase: the adjacent lines are
// 180 degrees out of phase, so they would invert the colour in the patch --
// two lines away is in phase.
float composite_sample(int r, int c) {
    float v = frame_in[r][c];
    if (dropout_mode == 1 || !is_dropout(r, c))
        return v;
    // Search outward for clean lines; a dropout often also covers the nearest
    // in-phase neighbours.
    float up_v = 0.0;
    float down_v = 0.0;
    bool up_ok = false;
    bool down_ok = false;
    for (int k = 2; k <= 8 && !up_ok; k += 2) {
        int rr = max(r - k, 0);
        if (!is_core_dropout(rr, c)) {
            up_v = frame_in[rr][c];
            up_ok = true;
        }
    }
    for (int k = 2; k <= 8 && !down_ok; k += 2) {
        int rr = min(r + k, SDTV_TOTAL_HEIGHT - 1);
        if (!is_core_dropout(rr, c)) {
            down_v = frame_in[rr][c];
            down_ok = true;
        }
    }
    if (up_ok && down_ok)
        return 0.5 * (up_v + down_v);
    if (up_ok)
        return up_v;
    if (down_ok)
        return down_v;
    return v;
}

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;

    if (row >= SDTV_TOTAL_HEIGHT || col >= SDTV_TOTAL_WIDTH)
        return;

    // The sync pulse is replaced by blanking level so that the settling tail
    // of the channel's imperfectly inverted sync edge cannot reach the colour
    // burst through the causal de-emphasis filter.  (Measured effect on the
    // Video Essentials capture: none -- the full-cycle burst correlation
    // already rejects the smooth transient -- but this makes the burst
    // reference immune to worse sync edges.)  Only columns before the burst
    // can see the pulse, so the picture is unaffected.
    concealed_out[row][col] = col < 74 ? level_offset : composite_sample(int(row), int(col));
}
