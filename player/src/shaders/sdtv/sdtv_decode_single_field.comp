#version 450

// This shader should be invoked with global invocation ids
// from (0, 0) until (SDTV_Y_BUF_WIDTH, SDTV_FIELD_HEIGHT).

#include "muse.h"

layout(push_constant) uniform PushConstants {
    uint field_parity;
    uint dropout_mode; // 0: normal, 1: disabled, 2: highlight
    uint use_3d_comb;  // 0 forces the spatial comb everywhere (key 4 / --no-3d-comb)
    float rot_re;
    float rot_im;
    float level_floor;   // below this, picture luma is considered illegal
    float level_ceiling; // likewise above this; both computed in SdtvDecoder
                         // from the measured blanking level and noise
    float chroma_sel_floor; // noise floor for the spatial/temporal comb
                            // selector, scaled from the measured sigma
    uint pal_v_flip;        // PAL: invert the derived V switch (calibration aid)
};

layout(set = 0, binding = 0) buffer readonly input_frame_buffer {
    float16_t input_frame[][SDTV_TOTAL_WIDTH];
};

layout(set = 0, binding = 1) buffer readonly color_burst_phase_data_buffer {
    f16vec2 phase_data[];
};

layout(set = 0, binding = 2) buffer writeonly Y_data_buffer {
    float16_t Y_data[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 3) buffer writeonly r_data_buffer {
    float16_t U_data[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 4) buffer writeonly b_data_buffer {
    float16_t V_data[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 5) buffer readonly dropout_data_buffer {
    uint8_t dropout_data[][SDTV_TOTAL_WIDTH];
};

layout(set = 0, binding = 6) buffer readonly prev_frame_buffer {
    float16_t prev_frame[][SDTV_TOTAL_WIDTH]; // composite of frame N-1
};

layout(set = 0, binding = 7) buffer readonly next_frame_buffer {
    float16_t next_frame[][SDTV_TOTAL_WIDTH]; // composite of frame N+1 (lookahead)
};

// Directional motion masks from sdtv_detect_motion.comp, frame-row indexed
layout(set = 0, binding = 8) buffer readonly past_motion_buffer {
    float16_t past_motion[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 9) buffer readonly future_motion_buffer {
    float16_t future_motion[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 10) buffer readonly prev_burst_phase_buffer {
    f16vec2 prev_phase_data[]; // per-line burst of frame N-1
};

layout(set = 0, binding = 11) buffer readonly next_burst_phase_buffer {
    f16vec2 next_phase_data[]; // per-line burst of frame N+1
};

layout(set = 0, binding = 12) buffer readonly prev_dropout_buffer {
    uint8_t prev_dropout[][SDTV_TOTAL_WIDTH];
};

layout(set = 0, binding = 13) buffer readonly next_dropout_buffer {
    uint8_t next_dropout[][SDTV_TOTAL_WIDTH];
};

// Per-column chroma estimates from sdtv_chroma_taps.comp: (spatial comb,
// pure temporal, motion-gated temporal, unused), field-row indexed, column
// x holding frame column x + SDTV_FIELD_START_X - SDTV_CHROMA_TAP_HALO
layout(set = 0, binding = 14) buffer readonly chroma_taps_buffer {
    f16vec4 chroma_taps[][SDTV_CHROMA_TAPS_WIDTH];
};

float16_t cosine_lut[] = { 1.hf, 0.hf, -1.hf, 0.hf };
float16_t sine_lut[] = { 0.hf, 1.hf, 0.hf, -1.hf };

float16_t color_cosine(uint col) {
    return cosine_lut[col % 4];
}

float16_t color_sine(uint col) {
    return sine_lut[col % 4];
}

// Post-demodulation chroma lowpass: 19-tap Hamming-windowed sinc, 1.0 MHz
// cutoff on the 4 fsc grid (-60 dB at fsc, -52 dB at the 2 fsc demodulation
// image).  Applied to the raw demodulation products, it also interpolates the
// missing quadrature: at 4 fsc each sample carries only one of them.
const float16_t chroma_lowpass[19] = float16_t[](
    -0.00218987hf, -0.00165572hf, 0.00063727hf, 0.00857601hf, 0.02546721hf,
    0.05192392hf, 0.08466937hf, 0.11698703hf, 0.14079925hf, 0.14957109hf,
    0.14079925hf, 0.11698703hf, 0.08466937hf, 0.05192392hf, 0.02546721hf,
    0.00857601hf, 0.00063727hf, -0.00165572hf, -0.00218987hf);

float16_t comb_luma(uint frame_line, uint next_line, uint frame_col) {
    return 0.25hf * input_frame[frame_line - 1][frame_col]
           + 0.5hf * input_frame[frame_line][frame_col]
           + 0.25hf * input_frame[next_line][frame_col];
}

float16_t comb_luma_prev(uint fl, uint nl, uint fc) {
    return 0.25hf * prev_frame[fl - 1][fc] + 0.5hf * prev_frame[fl][fc] + 0.25hf * prev_frame[nl][fc];
}

float16_t comb_luma_next(uint fl, uint nl, uint fc) {
    return 0.25hf * next_frame[fl - 1][fc] + 0.5hf * next_frame[fl][fc] + 0.25hf * next_frame[nl][fc];
}

#include "sdtv/sdtv_comb_taps.h"

// A neighbour frame's spatial luma: its composite less the band around fsc
// of its own 3-line comb chroma estimate (see y_spatial in main)
float16_t spatial_luma_prev(uint fl, uint nl, uint fc) {
    return prev_frame[fl][fc] - (0.5hf * chroma_sample_prev(fl, nl, fc)
                                 - 0.25hf * (chroma_sample_prev(fl, nl, fc - 2) + chroma_sample_prev(fl, nl, fc + 2)));
}

float16_t spatial_luma_next(uint fl, uint nl, uint fc) {
    return next_frame[fl][fc] - (0.5hf * chroma_sample_next(fl, nl, fc)
                                 - 0.25hf * (chroma_sample_next(fl, nl, fc - 2) + chroma_sample_next(fl, nl, fc + 2)));
}

// The absolute burst reference drifts across the line for the same reason
// the pair rotations do, so interpolate it per column between this line's
// burst and the next line's (structural 180 removed).  The magnitudes carry
// the burst-referenced AGC gain, so the plain complex lerp interpolates the
// gain alongside the phase (the chord shortening is negligible at these
// angles).  Fall back to the line's own burst when the neighbour is
// achromatic or implausibly far off: a dropout through the burst window, or
// the clamped last line, where the "neighbour" is the line itself and the
// negation lands 180 degrees away.
f16vec2 interpolated_burst(f16vec2 b0, f16vec2 b1, float t) {
    vec2 v0 = vec2(b0);
    vec2 v1 = -vec2(b1); // adjacent lines are 180 degrees apart
    float g0 = dot(v0, v0);
    float g1 = dot(v1, v1);
    if (g0 < 1e-4 || g1 < 1e-4 || dot(v0, v1) < 0.5 * sqrt(g0 * g1))
        return b0;
    return f16vec2(mix(v0, v1, t));
}



// The spatial and temporal estimates fail differently: the spatial comb
// leaks vertical luma detail (and hanging-dot errors at horizontal chroma
// edges) into its estimate but is exact on vertically uniform content,
// while the temporal estimate is blind to vertical detail but carries the
// residue of frame-to-frame sampling phase jitter (a few degrees of
// subcarrier), which shimmers on saturated flat areas.  Where the picture
// is vertically uniform the two estimates agree to within that jitter
// residue -- which scales with the chroma envelope -- so a disagreement
// beyond a few % of the envelope (and above the noise floor) is the spatial
// comb's leak, and only then is the temporal estimate worth its jitter.
float16_t temporal_weight(const float16_t cs[19], const float16_t ct[19]) {
    float16_t e_s = 0.hf;
    float16_t d = 0.hf;
    for (int n = 0; n < 19; n++) {
        e_s += abs(cs[n]);
        d += abs(cs[n] - ct[n]);
    }
    float16_t floor_ = float16_t(chroma_sel_floor);
    return clamp((d - 0.02hf * e_s - floor_) / (0.2hf * e_s + floor_), 0.hf, 1.hf);
}

f16vec2 demodulated_chroma(const float16_t c_src[19], uint frame_col) {
    float16_t c_re = 0.hf;
    float16_t c_im = 0.hf;
    for (int n = 0; n < 19; n++) {
        uint fc = uint(int(frame_col) + n - 9);
        float16_t cs = 2.hf * c_src[n];
        c_re += chroma_lowpass[n] * cs * color_cosine(fc);
        c_im += chroma_lowpass[n] * cs * color_sine(fc);
    }
    return f16vec2(c_re, c_im);
}

#ifdef SDTV_PAL
// The PAL decode reads one of three frames: this one (src 0), or the
// previous / next for the temporal dropout donor (-1 / +1).  GLSL has no
// buffer references, so the source is selected per access.
float16_t pal_f(int src, uint fl, uint fc) {
    return src == 0 ? input_frame[fl][fc] : src < 0 ? prev_frame[fl][fc] : next_frame[fl][fc];
}

f16vec2 pal_burst(int src, uint fl) {
    return src == 0 ? phase_data[fl] : src < 0 ? prev_phase_data[fl] : next_phase_data[fl];
}

// The field neighbour a line pairs with: the one below, except for the
// field's last line
uint pal_pair_line(uint fl, uint field_last) {
    return fl < field_last ? fl + 1 : fl - 1;
}

// The line's chroma estimate at a column: the composite less the mean of
// its two field neighbours, whose chroma is at -90 and +90 degrees and
// cancels (the field's first line borrows the blank line above it)
float16_t pal_chroma(int src, uint fl, uint field_last, uint fc) {
    // on the field's last line the line two above (181 degrees, the same V
    // switch) stands in as a two-line comb
    return fl < field_last
        ? pal_f(src, fl, fc) - 0.5hf * (pal_f(src, fl - 1, fc) + pal_f(src, fl + 1, fc))
        : 0.5hf * (pal_f(src, fl, fc) - pal_f(src, fl - 2, fc));
}

// The line's luma at a column: the composite less the chroma band of the
// comb estimate
float16_t pal_luma(int src, uint fl, uint field_last, uint fc) {
    return pal_f(src, fl, fc) - (0.5hf * pal_chroma(src, fl, field_last, fc)
                                 - 0.25hf * (pal_chroma(src, fl, field_last, fc - 2) + pal_chroma(src, fl, field_last, fc + 2)));
}

// The -U axis reference of a PAL line from the line pair, with the
// burst-referenced gain in its magnitude, and the line's V switch (see
// main); false where there is no usable burst
bool pal_reference(int src, uint fl, uint field_last, out vec2 bref, out float vs) {
    const uint nxt = pal_pair_line(fl, field_last);
    // The measured phasor is the conjugate of the subcarrier phase (see the
    // sine LUT), so the physical advance of +270.576 degrees per line is
    // undone by rotating the next line's phasor by +270.576 (the previous
    // line's by -270.576).
    vec2 m0 = vec2(pal_burst(src, fl));
    vec2 m1 = vec2(pal_burst(src, nxt));
    const float delta = radians(270.576) * (nxt > fl ? 1.0 : -1.0);
    vec2 m1r = vec2(m1.x * cos(delta) - m1.y * sin(delta), m1.x * sin(delta) + m1.y * cos(delta));
    vec2 r = m0 + m1r;
    float rl = length(r);
    bref = vec2(0.0);
    vs = 1.0;
    if (dot(m0, m0) <= 0.04 || dot(m1, m1) <= 0.04 || rl <= 0.5)
        return false;
    // Burst-referenced AGC: a nominal 0.214-unit burst measures 3.43 per
    // line, 4.85 for the pair sum along -U; 3.75 is the value calibrated
    // against the GGV1011 test disc's colour bars (the decoded saturation
    // was 1.3 times what the bars' own luma implied; the burst window reads
    // low against steady chroma, as NTSC's 2.92 against 3.2 covers there)
    float gain = clamp(3.75 / rl, 0.25, 8.0);
    bref = r / rl * gain;
    // this line's V switch: which side of -U its burst swung to
    vs = (m0.y * r.x - m0.x * r.y) >= 0.0 ? 1.0 : -1.0;
    if (pal_v_flip != 0u)
        vs = -vs;
    return true;
}

// U and V from a chroma window, against the reference
vec2 pal_demod(const float16_t c_src[19], uint frame_col, vec2 bref, float vs) {
    f16vec2 c_demod = demodulated_chroma(c_src, frame_col);
    float I = float(c_demod.x) * bref.x + float(c_demod.y) * bref.y;
    float Q = float(c_demod.y) * bref.x - float(c_demod.x) * bref.y;
    // as for NTSC: U + jV = e^(ja) conj(I + jQ), a = 180 + tint
    return vec2(Q * rot_re + I * rot_im, (I * rot_re - Q * rot_im) * vs);
}

// One PAL line's U and V at a column from its own spatial comb
vec2 pal_line_uv(int src, uint fl, uint field_last, uint frame_col) {
    vec2 bref; float vs;
    if (!pal_reference(src, fl, field_last, bref, vs))
        return vec2(0.0);
    float16_t c_src[19];
    for (int n = 0; n < 19; n++)
        c_src[n] = pal_chroma(src, fl, field_last, uint(int(frame_col) + n - 9));
    return pal_demod(c_src, frame_col, bref, vs);
}
#endif

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;

    if (row >= SDTV_FIELD_HEIGHT || col >= SDTV_Y_BUF_WIDTH)
        return;

    uint frame_line = SDTV_FIELD_START_Y + row + SDTV_FIELD2_OFFSET * field_parity;
    uint frame_col = col + SDTV_FIELD_START_X;
    uint mask_row = row * 2 + field_parity;

    // the comb degrades to two lines on the frame's last line
    uint next_line = min(frame_line + 1, SDTV_TOTAL_HEIGHT - 1);

#ifdef SDTV_PAL
    // PAL, 2D.  Adjacent lines of a field are 283.75 subcarrier cycles apart,
    // so their chroma phasors sit at -90 and +90 degrees from this line's
    // (270.576 and -270.576 on the line-locked 1135-sample grid, which is
    // 4 fsc to within 100 Hz): the two neighbours' chroma cancels in their
    // sum, whatever the V switch does (they share its sign), and
    //   c = f - (f_prev + f_next) / 2
    // is the line's chroma with a 1 % luma leak -- the same 3-line comb as
    // NTSC's with the centre tap doubled (there the neighbours are at 180
    // degrees).  The chroma reference is the -U axis, which the +-45 degree
    // swinging burst only gives from a line pair: the next line's burst
    // de-rotated by the structural 270.576 degrees into this line's frame,
    // added to this line's, is 2 cos 45 times the burst amplitude along -U
    // (the V parts cancel), and the side of that axis this line's burst
    // lies on is the line's V switch.  With use_3d_comb set (key 4, its
    // only meaning on PAL) the line's U and V are averaged with the
    // previous line's, the classic PAL delay-line step: 3 dB less chroma
    // noise, and a differential phase error, which lands on V with opposite
    // signs on consecutive lines, cancels instead of showing as Hanover
    // bars.  The dropout paths are NTSC's (see below): the illegal-level
    // rescue substitutes the nearest healthy line of the field -- any line
    // will do, each decodes against its own burst -- and a flagged pixel
    // takes the same pixel of the stiller neighbour frame, decoded in
    // place.  No temporal comb yet.
    {
        const uint field_first = SDTV_FIELD_START_Y + SDTV_FIELD2_OFFSET * field_parity;
        const uint field_last = field_first + SDTV_FIELD_HEIGHT - 1;
        float16_t Yp = pal_luma(0, frame_line, field_last, frame_col);
        bool pal_painted = false;
        bool pal_rescued = false;
        uint src_line = frame_line;

        int outside_p = 0;
        for (int dx = -2; dx <= 2; dx++) {
            float16_t y = dx == 0 ? Yp : pal_luma(0, frame_line, field_last, uint(int(frame_col) + dx));
            outside_p += (y < float16_t(level_floor) || y > float16_t(level_ceiling)) ? 1 : 0;
        }
        float16_t motion_p = max(past_motion[mask_row][col], future_motion[mask_row][col]);
        if (dropout_mode != 1 && outside_p >= 3 && motion_p > 0.1hf) {
            if (dropout_mode == 2) {
                pal_painted = true;
            } else {
                for (int k = 1; k <= 4 && !pal_rescued; k++) {
                    for (int side = -1; side <= 1 && !pal_rescued; side += 2) {
                        int fl = int(frame_line) + side * k;
                        if (fl < int(field_first) || fl > int(field_last))
                            continue;
                        float16_t y2 = pal_luma(0, uint(fl), field_last, frame_col);
                        if (y2 >= float16_t(level_floor) && y2 <= float16_t(level_ceiling)) {
                            Yp = y2;
                            src_line = uint(fl);
                            pal_rescued = true;
                        }
                    }
                }
            }
        }

        int pal_src = 0;
        if (dropout_mode == 0 && !pal_rescued && dropout_data[frame_line][frame_col] != 0 && motion_p > 0.1hf) {
            float16_t mp = past_motion[mask_row][col];
            float16_t mf = future_motion[mask_row][col];
            for (int attempt = 0; attempt < 2 && pal_src == 0; attempt++) {
                bool try_prev = (mp <= mf) == (attempt == 0);
                if ((try_prev ? mp : mf) > 0.5hf)
                    continue;
                if ((try_prev ? prev_dropout[frame_line][frame_col] : next_dropout[frame_line][frame_col]) != 0)
                    continue;
                pal_src = try_prev ? -1 : 1;
            }
            if (pal_src != 0)
                Yp = pal_luma(pal_src, frame_line, field_last, frame_col);
        }

        vec2 uv;
        const bool pal_temporal = use_3d_comb != 0u && !pal_rescued && pal_src == 0
                                  && dropout_data[frame_line][frame_col] == 0;
        if (pal_temporal) {
            // 3D comb, as NTSC's below with the frames two apart: the
            // subcarrier advances 270 degrees per frame and the V switch
            // flips, so it is frames N +- 2 whose chroma is inverted and
            // whose V switch matches -- the decoder feeds this shader (and
            // the motion detector) frames at that spacing.  The per-column
            // estimates come from sdtv_chroma_taps.comp: the PAL spatial
            // comb, and the temporal pairs through the burst pair rotation,
            // motion gated.
            float16_t cs_arr[19], ct_arr[19], pure_arr[19], c_src[19];
            for (int n = 0; n < 19; n++) {
                f16vec4 taps = chroma_taps[row][col + n];
                cs_arr[n] = taps.x;
                pure_arr[n] = taps.y;
                ct_arr[n] = taps.z;
            }
            float16_t w_t = temporal_weight(cs_arr, pure_arr);
            for (int n = 0; n < 19; n++)
                c_src[n] = mix(cs_arr[n], ct_arr[n], w_t);
            // luma as below: the composite less the chroma band of the
            // spatial estimate, averaged with the still neighbour frames'
            // own spatial lumas, or less the temporal estimate's band where
            // the spatial comb leaks
            float16_t f0 = input_frame[frame_line][frame_col];
            float16_t y_spatial = f0 - (0.5hf * cs_arr[9] - 0.25hf * (cs_arr[7] + cs_arr[11]));
            float16_t wp = prev_dropout[frame_line][frame_col] != 0 ? 0.hf : 1.hf - past_motion[mask_row][col];
            float16_t wf = next_dropout[frame_line][frame_col] != 0 ? 0.hf : 1.hf - future_motion[mask_row][col];
            float16_t y_avg = (0.5hf * y_spatial
                               + 0.25hf * (wp * pal_luma(-1, frame_line, field_last, frame_col)
                                           + wf * pal_luma(1, frame_line, field_last, frame_col)))
                              / (0.5hf + 0.25hf * (wp + wf));
            float16_t ct_band = 0.5hf * ct_arr[9] - 0.25hf * (ct_arr[7] + ct_arr[11]);
            Yp = mix(y_avg, f0 - ct_band, w_t);
            vec2 bref; float vs;
            uv = pal_reference(0, frame_line, field_last, bref, vs) ? pal_demod(c_src, frame_col, bref, vs) : vec2(0.0);
        } else {
            uv = pal_line_uv(pal_src, src_line, field_last, frame_col);
        }
        if (use_3d_comb != 0u && !pal_rescued && pal_src == 0) {
            // the delay-line U/V average with the line above (its own
            // spatial comb; the temporal estimate is per pixel here)
            const uint other = frame_line > field_first ? frame_line - 1 : frame_line + 1;
            uv = 0.5 * (uv + pal_line_uv(0, other, field_last, frame_col));
        }
        float16_t Up = float16_t(uv.x), Vp = float16_t(uv.y);
        if (dropout_mode == 2 && (pal_painted || (dropout_data[frame_line][frame_col] != 0 && motion_p > 0.1hf))) {
            Yp = 0.299hf;  // paint detected dropouts red, as below
            Up = -0.14714hf;
            Vp = 0.61497hf;
        }
        Y_data[row][col] = Yp;
        U_data[row][col] = Up;
        V_data[row][col] = Vp;
        return;
    }
#endif

    float16_t Y = comb_luma(frame_line, next_line, frame_col);
    bool painted = false;
    bool rescued = false;

    // Illegal-level rescue: picture luma below blanking level, or far above
    // white, is illegal -- short dropouts that keep a healthy-looking
    // envelope often land there.  Substitute the nearest line with the same
    // subcarrier phase.  (The envelope-detected dropouts are concealed
    // upstream in the copy shader; this catches what that detector cannot
    // see.)  Requiring three of five neighbouring samples outside the bounds
    // keeps the test blind both to the subcarrier-rate ringing that
    // saturated chroma edges leave in the comb luma and to noise around the
    // blanking level, so the floor can sit tight; a sustained spot passes.
    int outside = 0;
    for (int dx = -2; dx <= 2; dx++) {
        float16_t y = dx == 0 ? Y : comb_luma(frame_line, next_line, uint(int(frame_col) + dx));
        outside += (y < float16_t(level_floor) || y > float16_t(level_ceiling)) ? 1 : 0;
    }
    // An illegal level at a pixel the motion masks call still is picture
    // content, not a dropout: real dropout garbage deviates from the
    // neighbouring frames and registers as motion.  This keeps the sporadic
    // threshold flicker on high-contrast static detail (subtitle strokes
    // overshoot the ceiling on noise) from being "rescued" into smear.
    float16_t motion_here = max(past_motion[mask_row][col], future_motion[mask_row][col]);
    if (dropout_mode != 1 && outside >= 3 && motion_here > 0.1hf) {
        if (dropout_mode == 2) {
            painted = true;
        } else {
            for (int k = 2; k <= 8; k += 2) {
                uint fl = uint(clamp(int(frame_line) - k, SDTV_FIELD_START_Y, SDTV_TOTAL_HEIGHT - 1));
                float16_t y2 = comb_luma(fl, fl + 1, frame_col);
                if (y2 < float16_t(level_floor) || y2 > float16_t(level_ceiling)) {
                    fl = uint(clamp(int(frame_line) + k, SDTV_FIELD_START_Y, SDTV_TOTAL_HEIGHT - 1));
                    y2 = comb_luma(fl, fl + 1, frame_col);
                }
                if (y2 >= float16_t(level_floor) && y2 <= float16_t(level_ceiling)) {
                    Y = y2;
                    frame_line = fl;
                    next_line = min(fl + 1, SDTV_TOTAL_HEIGHT - 1);
                    rescued = true;
                    break;
                }
            }
        }
    }

    // The temporal paths only apply to healthy pixels: concealed or rescued
    // composite has no valid history in the neighbouring frames.
    bool own_flagged = dropout_data[frame_line][frame_col] != 0;
    bool temporal = use_3d_comb != 0 && !rescued && !own_flagged;

    // Temporal dropout concealment: for a flagged pixel whose surroundings
    // are still, the same pixel of the stiller neighbour frame is a far
    // better donor than the upstream line average.  The donor is decoded
    // in place (its own comb taps and its own burst reference); a side is
    // refused when its motion mask says the content moved or its own
    // dropout plane flags the same spot, and with both sides refused the
    // line-average concealment stands.
    int donor = 0; // 0: none, -1: previous frame, +1: next frame
    if (dropout_mode == 0 && !rescued && own_flagged && motion_here > 0.1hf) {
        float16_t mp = past_motion[mask_row][col];
        float16_t mf = future_motion[mask_row][col];
        for (int attempt = 0; attempt < 2 && donor == 0; attempt++) {
            bool try_prev = (mp <= mf) == (attempt == 0);
            if ((try_prev ? mp : mf) > 0.5hf)
                continue;
            if ((try_prev ? prev_dropout[frame_line][frame_col] : next_dropout[frame_line][frame_col]) != 0)
                continue;
            donor = try_prev ? -1 : 1;
        }
    }

    // Gather both chroma estimates over the demodulation window and blend by
    // the envelope comparison (the temporal candidates are already
    // motion-gated per column, so a moving column degenerates to spatial and
    // pulls the weight down with it).
    float16_t c_src[19];
    float t_burst = clamp((float(frame_col) - float(SDTV_BURST_START + 16)) / float(SDTV_TOTAL_WIDTH), 0.0, 1.0); // from the middle of the burst
    f16vec2 burst_ref = interpolated_burst(phase_data[frame_line], phase_data[next_line], t_burst);
    if (donor != 0) {
        for (int n = 0; n < 19; n++) {
            uint fc = uint(int(frame_col) + n - 9);
            c_src[n] = donor < 0 ? chroma_sample_prev(frame_line, next_line, fc)
                                 : chroma_sample_next(frame_line, next_line, fc);
        }
        Y = donor < 0 ? comb_luma_prev(frame_line, next_line, frame_col)
                      : comb_luma_next(frame_line, next_line, frame_col);
        burst_ref = donor < 0 ? interpolated_burst(prev_phase_data[frame_line], prev_phase_data[next_line], t_burst)
                              : interpolated_burst(next_phase_data[frame_line], next_phase_data[next_line], t_burst);
    } else if (temporal) {
        // 3D comb: the subcarrier inverts between adjacent frames, so for
        // still content the temporal pair differences are pure modulated
        // chroma, with no vertical resolution cost and full-bandwidth luma.
        // The directional motion masks blend each column between the still
        // temporal neighbours (both sides -> symmetric 3-tap, one side ->
        // that frame pair) and the spatial comb where the picture moves.
        // The selector, though, judges the ungated temporal estimate: the
        // masks answer whether temporal data is safe, the selector whether
        // it is worth anything -- feeding it the gated blend would let a
        // half-raised mask erase the disagreement it needs to see.
        // All three estimates are properties of the column, not of this
        // pixel, so sdtv_chroma_taps.comp evaluates them once per column
        // (this window used to recompute each of them 19 times).
        float16_t cs_arr[19], ct_arr[19], pure_arr[19];
        for (int n = 0; n < 19; n++) {
            f16vec4 taps = chroma_taps[row][col + n];
            cs_arr[n] = taps.x;
            pure_arr[n] = taps.y;
            ct_arr[n] = taps.z;
        }
        float16_t w_t = temporal_weight(cs_arr, pure_arr);
        for (int n = 0; n < 19; n++)
            c_src[n] = mix(cs_arr[n], ct_arr[n], w_t);

        // Spatial luma, for where the picture moves: the composite less
        // the chroma-band part of the 3-line comb's chroma estimate, so
        // that only the band around fsc is combed.  The plain comb luma
        // (0.25, 0.5, 0.25 over the lines) averages vertically at every
        // horizontal frequency, which costs a horizontal edge or a thin
        // stroke most of its sharpness for no separation benefit: there is
        // no chroma to remove outside that band.  Measured on still
        // content, where the temporal separation gives the true luma to
        // compare against, its error at vertical detail is 3-5 times that
        // of the band-limited form, for 1-2 dB less noise on flat areas.
        float16_t f0 = input_frame[frame_line][frame_col];
        float16_t y_spatial = f0 - (0.5hf * cs_arr[9] - 0.25hf * (cs_arr[7] + cs_arr[11]));

        // Temporal luma noise averaging: each neighbour frame's own spatial
        // luma is an independent estimate of the same still luma, so the
        // motion-gated (0.25, 0.5, 0.25) frame average carries ~4 dB less
        // noise where both neighbours are still (~2.5 dB with one), and
        // the vertical chroma residue -- hanging dots -- alternates sign
        // with the frame-to-frame subcarrier inversion and cancels.  The
        // frames' spatial lumas are the band-limited ones, as above: built
        // from the plain comb lumas, this average blurred every still
        // horizontal edge too faint to raise w_t (whose floor scales with
        // the noise), at 2-3 times the error for 1.5 dB less noise.
        // Subtracting the temporal chroma estimate instead would not help:
        // f0 - ct trades the comb's vertical averaging for an identical
        // temporal one, same weights, same variance (measured: 0.08 dB).
        // A neighbour is refused when its motion mask is raised or its
        // dropout plane flags this spot (concealed composite is not a
        // noise sample).  Where the spatial comb leaks vertical detail
        // (w_t high) the fsc-bandpassed temporal estimate replaces the
        // still average, full-resolution as before; the bandpass keeps
        // low-frequency residue of sub-threshold motion out of the luma.
        float16_t wp = prev_dropout[frame_line][frame_col] != 0
                           ? 0.hf : 1.hf - past_motion[mask_row][col];
        float16_t wf = next_dropout[frame_line][frame_col] != 0
                           ? 0.hf : 1.hf - future_motion[mask_row][col];
        float16_t y_avg = (0.5hf * y_spatial
                           + 0.25hf * (wp * spatial_luma_prev(frame_line, next_line, frame_col)
                                       + wf * spatial_luma_next(frame_line, next_line, frame_col)))
                          / (0.5hf + 0.25hf * (wp + wf));
        float16_t ct_band = 0.5hf * ct_arr[9] - 0.25hf * (ct_arr[7] + ct_arr[11]);
        Y = mix(y_avg, f0 - ct_band, w_t);
    } else if (!rescued && !own_flagged) {
        // 3D comb off: spatial separation throughout, as the moving parts
        // get it above
        for (int n = 0; n < 19; n++)
            c_src[n] = chroma_taps[row][col + n].x;
        Y = input_frame[frame_line][frame_col] - (0.5hf * c_src[9] - 0.25hf * (c_src[7] + c_src[11]));
    } else if (!rescued) {
        // A flagged pixel with no usable donor: the upstream concealment
        // stands, through the plain comb
        for (int n = 0; n < 19; n++)
            c_src[n] = chroma_taps[row][col + n].x;
    } else {
        for (int n = 0; n < 19; n++)
            c_src[n] = chroma_sample(frame_line, next_line, uint(int(frame_col) + n - 9));
    }

    f16vec2 c_demod = demodulated_chroma(c_src, frame_col);
    float16_t c_re = c_demod.x;
    float16_t c_im = c_demod.y;

    // rotate the c vector by the conjugate of the burst reference, which also
    // carries the burst-referenced gain (a + ib)(c + id) = ac-bd + i(bc+ad)

    float16_t b_re = burst_ref.x;
    float16_t b_im = burst_ref.y;

    float16_t I = c_re * b_re + c_im * b_im;
    float16_t Q = c_im * b_re - c_re * b_im;

    // As arranged below, the transform computes U + jV = e^(ja) conj(I + jQ)
    // with a = atan2(rot_re, rot_im): the conjugation reconciles the phase
    // direction of the sine LUT with the subcarrier's, and the angle folds
    // together the structural 180 degrees, the calibrated offset, and the
    // --tint option; --saturation scales the magnitude.  The values are
    // computed in SdtvDecoder.
    float16_t V = I * float16_t(rot_re) - Q * float16_t(rot_im);
    float16_t U = Q * float16_t(rot_re) + I * float16_t(rot_im);

    if (dropout_mode == 2 && (painted || (dropout_data[frame_line][frame_col] != 0 && motion_here > 0.1hf))) {
        // paint detected dropouts pure red (inverts through the RGB matrix
        // in the combine shader to (1, 0, 0))
        Y = 0.299hf;
        U = -0.14714hf;
        V = 0.61497hf;
    }

    Y_data[row][col] = Y;
    U_data[row][col] = U;
    V_data[row][col] = V;
}
