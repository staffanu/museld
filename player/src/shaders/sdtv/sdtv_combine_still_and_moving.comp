#version 450

#include "muse.h"

// This shader should be invoked with global invocation ids
// from (0, 0) until (SDTV_Y_BUF_WIDTH, SDTV_FIELD_HEIGHT * 2)

layout(push_constant) uniform PushConstants {
    // both set to 1 makes no sense
    uint force_field_only;  // bob: interpolate everything from the current field
    uint force_weave_only;  // weave: always take the missing rows from the previous field
    int field_parity;       // parity of the current field: 0 owns even output rows, 1 odd
    uint output_yuv;
    float black_setup;      // the disc's black level above blanking, as a fraction of blanking-to-white
    float nr_feedback;      // temporal noise reduction: the share of the previous output kept where still; 0 off
    uint nr_valid;          // the previous output in the nr buffers continues this picture
    uint nr_state_only;     // advance the noise reduction's state and write no picture (a film mode hold)
    uint edge_directed;     // interpolate the moving parts along the local edge direction, not just vertically
};

// The decoded fields, one buffer set per parity.  The set of the current
// field's parity was just decoded; the other set still holds the previous
// (opposite-parity) field, which is what the still parts weave in.
layout(set = 0, binding = 0) buffer readonly restrict field0_Y_buffer {
    float16_t field0_Y[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 1) buffer readonly restrict field0_U_buffer {
    float16_t field0_U[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 2) buffer readonly restrict field0_V_buffer {
    float16_t field0_V[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 3) buffer readonly restrict field1_Y_buffer {
    float16_t field1_Y[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 4) buffer readonly restrict field1_U_buffer {
    float16_t field1_U[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 5) buffer readonly restrict field1_V_buffer {
    float16_t field1_V[][SDTV_Y_BUF_WIDTH];
};

// Directional motion masks: past covers motion before the displayed frame's
// fields were captured, future motion after (from the lookahead frame)
layout(set = 0, binding = 6) buffer readonly restrict past_movement_buffer {
    float16_t past_movement[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 7) buffer readonly restrict future_movement_buffer {
    float16_t future_movement[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D frame_out_image;

layout(set = 0, binding = 9) buffer writeonly frame_out_y_buffer {
    uint16_t frame_out_Y[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 10) buffer writeonly frame_out_u_buffer {
    uint16_t frame_out_U[][SDTV_Y_BUF_WIDTH / 2];
};

layout(set = 0, binding = 11) buffer writeonly frame_out_v_buffer {
    uint16_t frame_out_V[][SDTV_Y_BUF_WIDTH / 2];
};

// The temporal noise reduction's state: the previous field's output of
// this row, before the setup and gamma; read and written in place
layout(set = 0, binding = 12) buffer restrict nr_y_buffer {
    float16_t nr_Y[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 13) buffer restrict nr_u_buffer {
    float16_t nr_U[][SDTV_Y_BUF_WIDTH];
};

layout(set = 0, binding = 14) buffer restrict nr_v_buffer {
    float16_t nr_V[][SDTV_Y_BUF_WIDTH];
};

f16vec3 currentField(uint i, uint col) {
    return field_parity == 0 ? f16vec3(field0_Y[i][col], field0_U[i][col], field0_V[i][col])
                             : f16vec3(field1_Y[i][col], field1_U[i][col], field1_V[i][col]);
}

f16vec3 previousField(uint i, uint col) {
    return field_parity == 0 ? f16vec3(field1_Y[i][col], field1_U[i][col], field1_V[i][col])
                             : f16vec3(field0_Y[i][col], field0_U[i][col], field0_V[i][col]);
}

float16_t currentFieldY(uint i, int col) {
    col = clamp(col, 0, SDTV_Y_BUF_WIDTH - 1);
    return field_parity == 0 ? field0_Y[i][col] : field1_Y[i][col];
}

// How badly the row above, shifted left by d, matches the row below shifted
// right by d: the sum of three absolute luma differences along that diagonal
float16_t diagonalMismatch(uint n0, uint n1, int col, int d) {
    return abs(currentFieldY(n0, col - d - 1) - currentFieldY(n1, col + d - 1))
         + abs(currentFieldY(n0, col - d)     - currentFieldY(n1, col + d))
         + abs(currentFieldY(n0, col - d + 1) - currentFieldY(n1, col + d + 1));
}

// The missing row interpolated from the current field's rows above (n0) and
// below (n1) along the direction in which they match best: the average of
// the pixel d to the left on the row above and d to the right on the row
// below, d chosen by a greedy search out from vertical (yadif's), which a
// diagonal edge rewards and a texture or noise does not.  The vertical
// average keeps the tie: a direction has to beat it by a margin above the
// noise, else a diagonal of the noise alone would steer thin lines about.
// A directional result is held within the range of the six nearest pixels
// of the two rows, which catches a match across a stroke thinner than the
// line pitch (the dot of an i joined to a diagonal).  Shifts beyond two
// pixels found more such mismatches than diagonals on a text card.
f16vec3 directionalBob(uint n0, uint n1, uint col) {
    const float16_t margin = 0.06hf; // three pixels of 2 IRE
    const int c = int(col);
    float16_t best = diagonalMismatch(n0, n1, c, 0) - margin;
    int best_d = 0;
    for (int sign = -1; sign <= 1; sign += 2) {
        for (int d = sign; abs(d) <= 2; d += sign) {
            float16_t score = diagonalMismatch(n0, n1, c, d);
            if (score >= best)
                break;
            best = score;
            best_d = d;
        }
    }
    if (best_d == 0)
        return 0.5hf * (currentField(n0, col) + currentField(n1, col));
    const uint left = uint(clamp(c - best_d, 0, SDTV_Y_BUF_WIDTH - 1));
    const uint right = uint(clamp(c + best_d, 0, SDTV_Y_BUF_WIDTH - 1));
    f16vec3 lo = min(currentField(n0, col), currentField(n1, col));
    f16vec3 hi = max(currentField(n0, col), currentField(n1, col));
    for (int k = -1; k <= 1; k += 2) {
        const uint cc = uint(clamp(c + k, 0, SDTV_Y_BUF_WIDTH - 1));
        lo = min(lo, min(currentField(n0, cc), currentField(n1, cc)));
        hi = max(hi, max(currentField(n0, cc), currentField(n1, cc)));
    }
    return clamp(0.5hf * (currentField(n0, left) + currentField(n1, right)), lo, hi);
}

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;

    if (row >= SDTV_FIELD_HEIGHT * 2 || col >= SDTV_Y_BUF_WIDTH)
        return;

    // Temporal noise reduction: a first-order recursion over the frames on
    // each row, out = in + k (prev_out - in), with k the feedback where the
    // picture is still and 0 where the motion masks say it moves (the same
    // masks that gate the weave, so what moves is never smeared).  A row's
    // state advances once per frame, on the field that samples it; the
    // other field's weave of that row shows the filtered state in place of
    // the raw decode, so the recursion is not fed the same sample twice.
    // The comb's 3-frame luma average sits before it.  Noise power falls by
    // (1 - k) / (1 + k) on white noise: 4.8 dB at 0.5, 8.5 dB at 0.75, on
    // still parts only.
    const bool nr = nr_feedback > 0.0;
    f16vec3 yuv;
    if (int(row & 1u) == field_parity) {
        // A row the current field sampled: use it directly
        yuv = currentField(row / 2, col);
        if (nr) {
            f16vec3 prev = nr_valid != 0u ? f16vec3(nr_Y[row][col], nr_U[row][col], nr_V[row][col]) : yuv;
            float16_t k = float16_t(nr_feedback) * (1.hf - clamp(past_movement[row][col], 0.hf, 1.hf));
            yuv = mix(yuv, prev, k);
            nr_Y[row][col] = yuv.x;
            nr_U[row][col] = yuv.y;
            nr_V[row][col] = yuv.z;
        }
    } else {
        // A row the current field did not sample.  Where the picture is
        // still, the previous field's row (which sits exactly here) is the
        // real thing; where it moves, that row is 1/60 s stale and would
        // comb, so interpolate the current field's neighbours instead.
        uint n0 = row / 2;
        uint n1 = uint(clamp(int(row / 2) + (field_parity == 0 ? 1 : -1), 0, SDTV_FIELD_HEIGHT - 1));
        f16vec3 bob = edge_directed != 0u ? directionalBob(n0, n1, col)
                                          : 0.5hf * (currentField(n0, col) + currentField(n1, col));
        f16vec3 weave = nr && nr_valid != 0u ? f16vec3(nr_Y[row][col], nr_U[row][col], nr_V[row][col])
                                             : previousField(row / 2, col);
        // Each field consults the evidence window that brackets its weave:
        // field 0 weaves the previous frame's field 1, whose staleness
        // interval lies in the past window; field 1 weaves this frame's
        // field 0, whose staleness interval [field 0, field 1] is only
        // covered by the lookahead differences.
        float16_t m = force_field_only != 0 ? 1.hf
                    : force_weave_only != 0 ? 0.hf
                    : field_parity == 0 ? past_movement[row][col]
                                        : future_movement[row][col];
        yuv = mix(weave, bob, m);
    }
    if (nr_state_only != 0u)
        return;
    float16_t Y = yuv.x, U = yuv.y, V = yuv.z;
    // The decoded signal has blanking at 0 and white at 1.  NTSC-M puts
    // black 7.5 IRE above blanking and squeezes the whole picture, chroma
    // included, into the remaining 92.5 IRE (the burst the chroma AGC
    // referenced stays at 40 IRE); NTSC-J puts black at blanking.  Place
    // black at 0 and undo the squeeze.
    const float16_t setup_gain = 1.hf / (1.hf - float16_t(black_setup));
    Y = (Y - float16_t(black_setup)) * setup_gain;
    U *= setup_gain;
    V *= setup_gain;
    Y = clamp(Y, 0.hf, 1.hf);
    U = clamp(U, -1.hf, 1.hf);
    V = clamp(V, -1.hf, 1.hf);

    float16_t r = Y + V * 1.139883hf;
    float16_t g = Y - U * 0.394642hf - V * 0.580622hf;
    float16_t b = Y + U * 2.032062hf;

    // r g b are the gamma-corrected studio signal (R'); apply the CRT EOTF to
    // get linear light for the sRGB swapchain, and convert the SMPTE C
    // primaries to sRGB -- the same display rendering as the MUSE path
    // (muse/combine_still_and_moving.comp), except that NTSC carries the
    // studio signal directly, with no transmission gamma to invert first.
    r = pow(clamp(r, 0.hf, 1.hf), 2.2hf);
    g = pow(clamp(g, 0.hf, 1.hf), 2.2hf);
    b = pow(clamp(b, 0.hf, 1.hf), 2.2hf);

#ifdef SDTV_PAL
    // EBU (BT.470 B/G) primaries to sRGB: only the green primary differs,
    // and barely
    float16_t r2 = 1.04404hf * r - 0.04404hf * g;
    float16_t g2 = g;
    float16_t b2 = 0.01179hf * g + 0.98821hf * b;
#else
    float16_t r2 =  9.3892e-01hf * r +  5.0196e-02hf * g + 1.0270e-02hf * b;
    float16_t g2 =  1.7760e-02hf * r +  9.6607e-01hf * g + 1.6424e-02hf * b;
    float16_t b2 = -1.6205e-03hf * r + -4.3710e-03hf * g + 1.0053e+00hf * b;
#endif

    imageStore(frame_out_image, ivec2(col, row), vec4(float(r2), float(g2), float(b2), 1.f));

    if (output_yuv != 0) {
        frame_out_Y[row][col] = uint16_t(clamp(Y * 256.hf, 0.hf, 255.hf) * 256.hf);
        if ((row & 1) == 0 && (col & 1) == 0) {
            // U and V carry modulation-scaled color differences (B-Y = 2.032062 U,
            // R-Y = 1.139883 V); rescale to full-range Cb = (B-Y)/1.772, Cr = (R-Y)/1.402
            float16_t Cb = U * 1.146757hf;
            float16_t Cr = V * 0.813040hf;
            frame_out_U[row / 2][col / 2] = uint16_t(clamp(Cb * 256.hf + 128.hf, 0.hf, 255.hf) * 256.hf);
            frame_out_V[row / 2][col / 2] = uint16_t(clamp(Cr * 256.hf + 128.hf, 0.hf, 255.hf) * 256.hf);
        }
    }
}
