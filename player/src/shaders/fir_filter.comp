#version 450

// This shader implements a one dimensional fir filter.
// and should be invoked with global invocation ids
// from 0 to output_size - 1.
//
// The input data will be indexed from 0 up to output_size + filter_size - 1.
// The output data will be indexed from output_offset up to output_offset + output_size - 1.

#include "muse.h"

layout(push_constant) uniform PushConstants {
    uint filter_size;
    uint output_size;
    uint output_offset;
    uint decimation_rate;
};

layout(set = 0, binding = 0) buffer readonly filter_buffer {
    float fir_filter[];
};

layout(set = 0, binding = 1) buffer readonly input_buffer {
    float input_data[];
};

layout(set = 0, binding = 2) buffer writeonly output_buffer {
    float output_data[];
};

// The longest filter and largest decimation this pipeline will be dispatched with, set by the
// host from the filters it actually built.  They cannot come from the push constants above:
// shared memory is sized when the pipeline is created, while push constants vary per dispatch.
// Specializing them instead of assuming a fixed upper bound keeps the shared block to what the
// filters need -- an upper bound of 64 taps and a decimation of 4 would declare 16896 bytes at
// a 1024-invocation workgroup, past the 16384 that maxComputeSharedMemorySize is only
// guaranteed to be.  The workgroup size is a specialization constant too, so the block also
// shrinks on devices that allow fewer invocations.
layout (constant_id = 4) const uint max_filter_size = 64;
layout (constant_id = 5) const uint max_decimation = 4;

// we assume that the workgroup size is at least max_filter_size
shared float shared_filter[max_filter_size];
shared float shared_input[gl_WorkGroupSize.x * max_decimation + max_filter_size];

void main() {
    uint global_ix = gl_GlobalInvocationID.x;
    uint local_ix = gl_LocalInvocationID.x;
    uint local_size = gl_WorkGroupSize.x;

    if (local_ix < filter_size)
            shared_filter[local_ix] = fir_filter[local_ix];

    uint base_ix = (global_ix - local_ix) * decimation_rate;

    for (int i = 0; i < decimation_rate; i++)
        shared_input[local_ix + i * local_size] = input_data[base_ix + local_ix + i * local_size];
    // The tail beyond the workgroup's own samples is the filter's overlap, which is
    // filter_size - decimation_rate samples long.  Bounding it by the specialized tap count
    // instead read one sample past the end of the input buffer on the last workgroup, and on
    // a dispatch decimating by less than the pipeline was specialized to, several.
    if (local_ix + decimation_rate < filter_size)
        shared_input[local_ix + decimation_rate * local_size] = input_data[base_ix + local_ix + decimation_rate * local_size];

    barrier();

    if (global_ix >= output_size)
        return;

    float s = 0.f;
    for (uint i = 0; i < filter_size; i++) {
        s += shared_filter[i] * shared_input[local_ix * decimation_rate + i];
    }

    output_data[output_offset + global_ix] = s;
}
