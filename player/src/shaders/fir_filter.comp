#version 450

// A one dimensional FIR filter, register-blocked: each invocation loads one
// window of input samples into registers and produces outputs_per_invocation
// consecutive outputs from it, which amortizes the loads and the per-invocation
// overhead over several outputs.  The tap count, the decimation and the block
// size are specialization constants, so every loop below has a constant trip
// count once the pipeline is compiled and the arrays live in registers.
//
// Measured on an Apple M2 against the previous shader (one output per
// invocation from a shared-memory tile): two outputs per invocation ran the
// 25-tap band-pass 3x faster and the decimating 19-tap low-pass 2.5x faster.
// Four and eight outputs per invocation were slower than two on that GPU for
// these windows (the 24-tap de-emphasis in sdtv_deemphasis.comp is fastest at
// four), so the count is a specialization constant and worth re-measuring
// on other hardware.  The taps are accumulated with an explicit fma(), which
// is what the driver made of the plain expression before, so the output is
// bit-identical to it.
//
// It should be invoked with global invocation ids from 0 to
// ceil(output_size / outputs_per_invocation) - 1.
//
// The input data is indexed from 0 up to (output_size - 1) * decimation_rate + filter_size - 1.
// The output data is indexed from output_offset up to output_offset + output_size - 1.
// The filter correlates rather than convolves: reverse the taps of an asymmetric filter.

#include "muse.h"

layout(push_constant) uniform PushConstants {
    uint output_size;
    uint output_offset;
};

layout(set = 0, binding = 0) buffer readonly filter_buffer {
    float fir_filter[];
};

layout(set = 0, binding = 1) buffer readonly input_buffer {
    float input_data[];
};

layout(set = 0, binding = 2) buffer writeonly output_buffer {
    float output_data[];
};

layout (constant_id = 4) const uint filter_size = 1;
layout (constant_id = 5) const uint decimation_rate = 1;
layout (constant_id = 6) const uint outputs_per_invocation = 4;

const uint window_size = filter_size + (outputs_per_invocation - 1) * decimation_rate;

void main() {
    uint first_output = gl_GlobalInvocationID.x * outputs_per_invocation;

    if (first_output >= output_size)
        return;

    // The last invocation of a block whose size is not a multiple of
    // outputs_per_invocation would otherwise read past the input.
    uint last_input = (output_size - 1) * decimation_rate + filter_size - 1;
    uint window_base = first_output * decimation_rate;
    float window[window_size];
    for (uint k = 0; k < window_size; k++)
        window[k] = input_data[min(window_base + k, last_input)];

    float taps[filter_size];
    for (uint i = 0; i < filter_size; i++)
        taps[i] = fir_filter[i];

    for (uint o = 0; o < outputs_per_invocation; o++) {
        if (first_output + o >= output_size)
            break;
        float s = 0.f;
        for (uint i = 0; i < filter_size; i++)
            s = fma(taps[i], window[o * decimation_rate + i], s);
        output_data[output_offset + first_output + o] = s;
    }
}
