#version 450

#include "muse.h"

// This shader should be invoked with global invocation ids
// from (0, 0) until (MUSE_Y_BUF_WIDTH * 3, MUSE_BUF_HEIGHT * 2)

layout(push_constant) uniform PushConstants {
    // both set to 1 makes no sense
    uint force_field_only;
    uint force_inter_frame_only;
    int field_parity; // Parity for the field buffer: 0 for first field (lower), 1 for second (upper)
    uint output_yuv;
};

layout(set = 0, binding = 0) buffer readonly restrict field_Y_buffer {
    float16_t field_y[MUSE_BUF_HEIGHT][MUSE_Y_BUF_WIDTH * 3];
};

layout(set = 0, binding = 1) buffer readonly restrict field_r_buffer {
    float16_t field_r[MUSE_BUF_HEIGHT / 2][MUSE_Y_BUF_WIDTH / 2];
};

layout(set = 0, binding = 2) buffer readonly restrict field_b_buffer {
    float16_t field_b[MUSE_BUF_HEIGHT / 2][MUSE_Y_BUF_WIDTH / 2];
};

layout(set = 0, binding = 3) buffer readonly restrict inter_frame_Y_buffer {
    float16_t inter_frame_y[MUSE_BUF_HEIGHT * 2][MUSE_Y_BUF_WIDTH * 3];
};

layout(set = 0, binding = 4) buffer readonly restrict inter_frame_r_buffer {
    float16_t inter_frame_r[MUSE_BUF_HEIGHT * 2][MUSE_Y_BUF_WIDTH];
};

layout(set = 0, binding = 5) buffer readonly restrict inter_frame_b_buffer {
    float16_t inter_frame_b[MUSE_BUF_HEIGHT * 2][MUSE_Y_BUF_WIDTH];
};

layout(set = 0, binding = 6) buffer readonly restrict movement_buffer {
    float16_t movement_data[MUSE_BUF_HEIGHT * 2][MUSE_Y_BUF_WIDTH * 3];
};

layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D frame_out_image;

layout(set = 0, binding = 8) buffer writeonly frame_out_y_buffer {
    uint16_t frame_out_y[MUSE_BUF_HEIGHT * 2][MUSE_Y_BUF_WIDTH * 3];
};

layout(set = 0, binding = 9) buffer writeonly frame_out_u_buffer {
    uint16_t frame_out_u[MUSE_BUF_HEIGHT][MUSE_Y_BUF_WIDTH * 3 / 2];
};

layout(set = 0, binding = 10) buffer writeonly frame_out_v_buffer {
    uint16_t frame_out_v[MUSE_BUF_HEIGHT][MUSE_Y_BUF_WIDTH * 3 / 2];
};

// Constants for the RGB inverse-gamma curve of ITU-R BO.786 §3.2.8.1:
//   y = A(x - B)^2.2 + C
// The spec determines them by: the curve passes through (0,0) and (1,1), and the
// ratio of gradients at those points is 1:5.
// => [1 (0,0)]: A(-B)^2.2 + C = 0
//    [2 (1,1)]: A(1 - B)^2.2 + C = 1
//    [3 (derivative)]: 5 * 2.2 A(-B)^1.2 = 2.2 A(1 - B)^1.2
// Numerical solution yields A=0.541579, B=-0.354155, C=-0.055193
// These correspond well to the values given in Figure 4.50 in MUSE－ハイビジョン伝送方式 (from NHK).
const float16_t inv_gamma_A = 0.541579hf;
const float16_t inv_gamma_B = -0.354155hf;
const float16_t inv_gamma_C = -0.055193hf;

// The encoder applies the §3.2.8.1 curve to R, G, B before the matrix, so the
// matrix output here is in that "pseudo-linear" domain, not linear light.
// Invert the curve to recover the studio gamma-corrected signal (R'), then apply
// the CRT EOTF (gamma 2.2) to get linear light for the sRGB swapchain.
// Verified against analog component output levels of a reference (Sony) decoder.
float16_t display_linear(float16_t p) {
    float16_t rp = pow((p - inv_gamma_C) / inv_gamma_A, 1.0hf / 2.2hf) + inv_gamma_B;
    return pow(clamp(rp, 0.0hf, 1.0hf), 2.2hf);
}

// Unfortunately having two versions of the color interpolation functions is necessary since we cannot pass the buffer itself
// to the function -- tried that and it seems that it is copied despite being read-only!
// The chroma of the still path sits on the luma grid (decode_c), chroma sample
// k of the compressed slot at 4k + o for the sub-sampling phase o.  That grid
// is two thirds of a luma pixel (two columns here) to the right of the
// picture: measured on the Sony test disc's white/blue checker and on its
// colour bars, in the written file's own U/V planes, the chroma edge lay 0.65
// luma pixels after the luma edge with the grids aligned, and lies within a
// tenth of it with this shift, in both fields and in both paths (2026-11-17;
// a whole pixel put it a quarter to a half pixel early).  The further +1
// centres the 1:3 filter on its sample.
const int c_chroma_shift = 2 + 1;
float16_t resample_inter_frame_r(uint row, uint col) {
    // a Catmull-Rom cubic through the four nearest chroma samples (a triangle over two before, 2026-11-20)
    int c = int(col) + c_chroma_shift - 1;
    int n0 = c / 3;
    float16_t t = float16_t(c - 3 * n0) / 3.hf;
    int nm = max(n0 - 1, 0), n1 = min(n0 + 1, MUSE_Y_BUF_WIDTH - 1), n2 = min(n0 + 2, MUSE_Y_BUF_WIDTH - 1);
    n0 = min(n0, MUSE_Y_BUF_WIDTH - 1);
    float16_t pm = inter_frame_r[row][nm], p0 = inter_frame_r[row][n0], p1 = inter_frame_r[row][n1], p2 = inter_frame_r[row][n2];
    float16_t t2 = t * t, t3 = t2 * t;
    return 0.5hf * ((2.hf * p0) + (-pm + p1) * t + (2.hf * pm - 5.hf * p0 + 4.hf * p1 - p2) * t2 + (-pm + 3.hf * p0 - 3.hf * p1 + p2) * t3);
}

float16_t resample_inter_frame_b(uint row, uint col) {
    // a Catmull-Rom cubic through the four nearest chroma samples (a triangle over two before, 2026-11-20)
    int c = int(col) + c_chroma_shift - 1;
    int n0 = c / 3;
    float16_t t = float16_t(c - 3 * n0) / 3.hf;
    int nm = max(n0 - 1, 0), n1 = min(n0 + 1, MUSE_Y_BUF_WIDTH - 1), n2 = min(n0 + 2, MUSE_Y_BUF_WIDTH - 1);
    n0 = min(n0, MUSE_Y_BUF_WIDTH - 1);
    float16_t pm = inter_frame_b[row][nm], p0 = inter_frame_b[row][n0], p1 = inter_frame_b[row][n1], p2 = inter_frame_b[row][n2];
    float16_t t2 = t * t, t3 = t2 * t;
    return 0.5hf * ((2.hf * p0) + (-pm + p1) * t + (2.hf * pm - 5.hf * p0 + 4.hf * p1 - p2) * t2 + (-pm + 3.hf * p0 - 3.hf * p1 + p2) * t3);
}

float16_t resample_field_y(uint row, uint col) {
    if ((row & 1u) != field_parity) {
        // for field 1, even rows have a corresponding row in the interpolated field;
        // for field 0, odd rows are exactly represented.
        return field_y[row / 2][col];
    } else {
        // the other rows are interpolated from the two field rows on either side with the cubic -1/16 9/16 9/16 -1/16
        // (the average of the two neighbours before, 2026-11-20: 51 against 47% at 370 TV lines on the Sony test disc, no cost)
        int above = row == 0 ? 0 : (int(row) - 1) / 2;
        int below = min(above + 1, MUSE_BUF_HEIGHT - 1);
        int above2 = max(above - 1, 0);
        int below2 = min(below + 1, MUSE_BUF_HEIGHT - 1);
        return (9.hf / 16.hf) * (field_y[above][col] + field_y[below][col]) - (1.hf / 16.hf) * (field_y[above2][col] + field_y[below2][col]);
    }
}

// For the intra field color interpolation we just do linear interpolation
float16_t resample_field_r(uint row, uint col) {
    // a separable Catmull-Rom cubic over the 4x4 nearest field chroma samples, which sit 4 rows and
    // 6 columns apart on the output grid (bilinear before, 2026-11-20; the edges are held as they were)
    int top_left_y = 1 - field_parity;
    int top_left_x = 3 * field_parity;
    int ry = int(row) - top_left_y;
    int r0 = ry >= 0 ? ry / 4 : -1;
    float16_t ty = float16_t(ry - 4 * r0) / 4.hf;
    const int cc = int(col) + c_chroma_shift - 1 - top_left_x;
    int c0 = cc >= 0 ? cc / 6 : -1;
    float16_t tx = float16_t(cc - 6 * c0) / 6.hf;
    const int RM = MUSE_BUF_HEIGHT / 2 - 1, CM = MUSE_Y_BUF_WIDTH / 2 - 1;
    int rr[4] = int[](clamp(r0 - 1, 0, RM), clamp(r0, 0, RM), clamp(r0 + 1, 0, RM), clamp(r0 + 2, 0, RM));
    int cs[4] = int[](clamp(c0 - 1, 0, CM), clamp(c0, 0, CM), clamp(c0 + 1, 0, CM), clamp(c0 + 2, 0, CM));
    float16_t wx[4] = float16_t[](0.5hf * (-tx + 2.hf * tx * tx - tx * tx * tx), 0.5hf * (2.hf - 5.hf * tx * tx + 3.hf * tx * tx * tx),
                                  0.5hf * (tx + 4.hf * tx * tx - 3.hf * tx * tx * tx), 0.5hf * (-tx * tx + tx * tx * tx));
    float16_t wy[4] = float16_t[](0.5hf * (-ty + 2.hf * ty * ty - ty * ty * ty), 0.5hf * (2.hf - 5.hf * ty * ty + 3.hf * ty * ty * ty),
                                  0.5hf * (ty + 4.hf * ty * ty - 3.hf * ty * ty * ty), 0.5hf * (-ty * ty + ty * ty * ty));
    float16_t s = 0.hf;
    for (int i = 0; i < 4; i++) {
        float16_t h = 0.hf;
        for (int j = 0; j < 4; j++)
            h += wx[j] * field_r[rr[i]][cs[j]];
        s += wy[i] * h;
    }
    return s;
}

float16_t resample_field_b(uint row, uint col) {
    // a separable Catmull-Rom cubic over the 4x4 nearest field chroma samples, which sit 4 rows and
    // 6 columns apart on the output grid (bilinear before, 2026-11-20; the edges are held as they were)
    int top_left_y = 1 - field_parity;
    int top_left_x = 3 * field_parity;
    int ry = int(row) - top_left_y;
    int r0 = ry >= 0 ? ry / 4 : -1;
    float16_t ty = float16_t(ry - 4 * r0) / 4.hf;
    const int cc = int(col) + c_chroma_shift - 1 - top_left_x;
    int c0 = cc >= 0 ? cc / 6 : -1;
    float16_t tx = float16_t(cc - 6 * c0) / 6.hf;
    const int RM = MUSE_BUF_HEIGHT / 2 - 1, CM = MUSE_Y_BUF_WIDTH / 2 - 1;
    int rr[4] = int[](clamp(r0 - 1, 0, RM), clamp(r0, 0, RM), clamp(r0 + 1, 0, RM), clamp(r0 + 2, 0, RM));
    int cs[4] = int[](clamp(c0 - 1, 0, CM), clamp(c0, 0, CM), clamp(c0 + 1, 0, CM), clamp(c0 + 2, 0, CM));
    float16_t wx[4] = float16_t[](0.5hf * (-tx + 2.hf * tx * tx - tx * tx * tx), 0.5hf * (2.hf - 5.hf * tx * tx + 3.hf * tx * tx * tx),
                                  0.5hf * (tx + 4.hf * tx * tx - 3.hf * tx * tx * tx), 0.5hf * (-tx * tx + tx * tx * tx));
    float16_t wy[4] = float16_t[](0.5hf * (-ty + 2.hf * ty * ty - ty * ty * ty), 0.5hf * (2.hf - 5.hf * ty * ty + 3.hf * ty * ty * ty),
                                  0.5hf * (ty + 4.hf * ty * ty - 3.hf * ty * ty * ty), 0.5hf * (-ty * ty + ty * ty * ty));
    float16_t s = 0.hf;
    for (int i = 0; i < 4; i++) {
        float16_t h = 0.hf;
        for (int j = 0; j < 4; j++)
            h += wx[j] * field_b[rr[i]][cs[j]];
        s += wy[i] * h;
    }
    return s;
}

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;

    if (row >= MUSE_BUF_HEIGHT * 2 || col >= MUSE_Y_BUF_WIDTH * 3)
        return;

    float16_t YM_field = resample_field_y(row, col);
    float16_t RmYM_field = resample_field_r(row, col) - 128.0hf;
    float16_t BmYM_field = resample_field_b(row, col) - 128.0hf;
    float16_t YM_inter_frame = inter_frame_y[row][col];
    float16_t RmYM_inter_frame = resample_inter_frame_r(row, col) - 128.0hf;
    float16_t BmYM_inter_frame = resample_inter_frame_b(row, col) - 128.0hf;

    // The color signal is amplified by 3 dB, so undo this
    RmYM_field *= 0.707hf;
    BmYM_field *= 0.707hf;
    RmYM_inter_frame *= 0.707hf;
    BmYM_inter_frame *= 0.707hf;

    float16_t movement = force_field_only != 0 ?
        1.0hf : force_inter_frame_only != 0 ?
            0.0hf : movement_data[row][col];

    float16_t YM = YM_field * movement + YM_inter_frame * (1.0hf - movement);
    float16_t BmYM = BmYM_field * movement + BmYM_inter_frame * (1.0hf - movement);
    float16_t RmYM = RmYM_field * movement + RmYM_inter_frame * (1.0hf - movement);

    // Picture black/white levels in the pseudo-linear (post-inverse-transmission-gamma)
    // domain.  Measured on the Sony test disc: picture content spans 35..218 pre-gamma,
    // i.e. 24.6..206.6 after the inverse transmission gamma, and the reference decoder
    // maps exactly these levels to 0 mV (picture black) and 700 mV (peak white) on its
    // analog component output.  The spec levels 16/239 are headroom references, not
    // picture extremes.
    const float16_t min_value = 24.6hf;
    const float16_t range = 206.6hf - min_value;
    float16_t g = clamp((YM - BmYM / 4.0hf - RmYM / 2.0hf - min_value) / range, 0.hf, 1.hf);
    float16_t b = clamp((YM + BmYM + BmYM / 4.0hf - min_value) / range, 0.hf, 1.hf);
    float16_t r = clamp((YM + RmYM - min_value) / range, 0.hf, 1.hf);

    // The matrix output is pseudo-linear (see display_linear); convert to linear light
    r = display_linear(r);
    g = display_linear(g);
    b = display_linear(b);

    // r g b are in linear space, but using SMPTE C color primaries.
    // Convert to sRGB colors used by Vulkan

    float16_t r2 =  9.3892e-01hf * r +  5.0196e-02hf * g + 1.0270e-02hf * b;
    float16_t g2 =  1.7760e-02hf * r +  9.6607e-01hf * g + 1.6424e-02hf * b;
    float16_t b2 = -1.6205e-03hf * r + -4.3710e-03hf * g + 1.0053e+00hf * b;

    imageStore(frame_out_image, ivec2(col, row), vec4(float(r2), float(g2), float(b2), 1.f));

    if (output_yuv != 0) {
        float16_t YM01 = (YM - min_value) / range;
        float16_t YM01postGamma = pow((YM01 - inv_gamma_C) / inv_gamma_A, 1.0hf / 2.2hf) + inv_gamma_B;

        frame_out_y[row][col] = uint16_t(clamp(YM01postGamma * 256.hf, 0.hf, 255.hf) * 256.hf);
        if ((row & 1) == 0 && (col & 1) == 0) {
            frame_out_u[row / 2][col / 2] = uint16_t(clamp((BmYM + 128.hf), 0.hf, 255.hf) * 256.hf);
            frame_out_v[row / 2][col / 2] = uint16_t(clamp((RmYM + 128.hf), 0.hf, 255.hf) * 256.hf);
        }
    }
}
