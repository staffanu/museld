#version 450

// This shader should be invoked with global invocation ids
// from (0, 0) until (MUSE_Y_BUF_WIDTH, MUSE_BUF_HEIGHT).
//
// Completes the chroma of the still path in place.  decode_c has spread the samples of
// four fields over a row grid where a colour difference occupies a pair of adjacent
// frame rows (rows 0 and 1 for red, 2 and 3 for blue, and so on), each row holding
// the samples of one field of two frames: every other column, and the two rows of a
// pair hold complementary columns.  The is_red flag says which colour the buffer
// holds.  filter_stage 0 completes the rows that have samples with the other row of
// the pair: the other field's adjacent line, whose sample at that column is as good
// as the row's own, since the line-sequential chroma is band-limited vertically to an
// eighth of a cycle per line (the NHK book's 1125/4 TV lines; its section 4.2 describes
// this inter-field interpolation).  Until 2026-11-20 each row was interpolated from
// its own neighbours, which halved the horizontal chroma resolution and quantised an
// edge's position a column apart in the two rows: a line-alternating sawtooth on every
// vertical chroma edge.  filter_stage 1 fills the other colour's rows vertically.

#include "muse.h"

layout(push_constant) uniform PushConstants {
    uint is_red;
    uint filter_stage;
};

layout(set = 0, binding = 0) buffer c_buffer {
    float16_t c_data[MUSE_BUF_HEIGHT * 2][MUSE_Y_BUF_WIDTH];
};

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;

    if (row >= MUSE_BUF_HEIGHT || col >= MUSE_Y_BUF_WIDTH)
        return;

    switch (filter_stage) {
        case 0: // the columns without a sample in the rows that have samples: from the other row of the pair
        {
            uint y = row / 2 * 4 + (row & 1u) + (is_red != 0 ? 0 : 2);
            uint known_pixels_phase = 1 - (row & 1u);
            if (col % 2 != known_pixels_phase)
                c_data[y][col] = c_data[y ^ 1u][col];
        }
        break;
        case 1: // Fill in the missing samples in the rows without samples (rows 0, 1 for blue, 2, 3 for red, and so on) by filtering vertically
        {
            uint y = row / 2 * 4 + (row & 1u) + (is_red != 0 ? 2 : 0);
            uint source_y_close, source_y_far;
            if ((row & 1u) == 0) {
                source_y_close = y == 0 ? 2 : y - 1;
                source_y_far = y == 2 * MUSE_BUF_HEIGHT - 2 ? y - 1 : y + 2;
            } else {
                source_y_close = y == 2 * MUSE_BUF_HEIGHT - 1 ? y - 2 : y + 1;
                source_y_far = y == 1 ? 2 : y - 2;
            }
            // Very simple "filter" just a weighted sum of the lines above and below
            c_data[y][col] = 0.66667hf * c_data[source_y_close][col] + 0.33333hf * c_data[source_y_far][col];
        }
        break;
    }
}
