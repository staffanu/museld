#version 450

// This shader implements dropout detection by comparing the demodulated values with what is reasonable.
// It should be invoked with global invocation ids from 0 to dest_size - 1.
//
// The source data will be indexed from source_offset up to source_offset + video_decimation_rate * dest_size - 1.
// The destination data will be indexed from dest_offset up to dest_offset + dest_size - 1.

#include "muse.h"

layout(push_constant) uniform PushConstants {
    uint dest_size;
    uint source_offset;
    uint dest_offset;
    uint video_decimation_rate;
    // The legal demodulated signal range, in the demodulator's own units --
    // both wider than the nominal video range, since pre-emphasis overshoots
    // are part of a healthy signal.
    float low_threshold;
    float high_threshold;
};

layout(set = 0, binding = 0) buffer readonly source_buffer {
    float source[];
};

layout(set = 0, binding = 1) buffer writeonly dest_buffer {
    uint8_t dest[];
};

void main() {
    uint ix = gl_GlobalInvocationID.x;

    if (ix >= dest_size)
        return;

    // We interpret excessive signal values to indicate a dropout: when the
    // carrier drops out, the FM demodulator produces frequency estimates far
    // outside the legal deviation range.
    int dropout = 0;
    for (uint i = 0; i < video_decimation_rate; i++) {
        float v = source[source_offset + ix * video_decimation_rate + i];
        if (v < low_threshold || v > high_threshold)
            dropout = 1;
    }

    dest[dest_offset + ix] = uint8_t(dropout);
}
