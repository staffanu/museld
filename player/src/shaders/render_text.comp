#version 450

#include "muse.h"

// To be invoked with indices [0, 0] to (n_characters * font_width * scale, font_height * scale).

layout(push_constant) uniform PushConstants {
    uint16_t top_left_x;
    uint16_t top_left_y;
    uint16_t scale;
    uint16_t glyph_width; // spacing between characters -- if less than 16 we render the left (most significant) bits
    uint16_t glyph_height;
    uint16_t n_characters; // max 2*58 characters for a total of 128 bytes push constants (which is guaranteed)
    uint16_t text[58]; // coded as byte indices in the font, so 0 means codepoint c_font_codepoint_begin, 2 per item
};

// uint32_t instead of uint16_t: some AMD drivers (observed on Ryzen integrated GPU) produce
// corrupted reads from uint16_t SSBOs, causing font pixels to appear byte-swapped. The font
// data fits in the lower 16 bits of each uint and the bit manipulation below is unaffected.
layout(set = 0, binding = 0) buffer readonly font_buffer {
    uint font[];
};

layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D frame_out_image;

void main() {
    uint y = gl_GlobalInvocationID.y;
    uint x = gl_GlobalInvocationID.x;

    if (x >= n_characters * glyph_width * scale || y >= glyph_height * scale)
        return;

    uint char_index = x / glyph_width / scale;
    uint text_chars = text[char_index / 2];
    uint glyph_index = (char_index & 1u) == 0 ? text_chars >> 8 : text_chars & 0xffu;

    uint x_in_glyph = x - char_index * glyph_width * scale;

    uint line = font[y / scale + glyph_index * glyph_height];
    uint pixel = line & (0x8000u >> (x_in_glyph / scale));
    if (pixel != 0) {
        imageStore(frame_out_image, ivec2(x + top_left_x, y + top_left_y), vec4(1.f, 1.f, 1.f, 1.f));
    }
}
