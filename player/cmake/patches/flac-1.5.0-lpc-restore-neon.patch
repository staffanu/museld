--- a/src/libFLAC/lpc.c
+++ b/src/libFLAC/lpc.c
@@ -44,6 +44,78 @@
 #include "private/lpc.h"
 #include "private/macros.h"
 
+/* The decoder's LPC restore with NEON (museld patch, 2026-11; the x86
+ * builds dispatch to their SSE/AVX versions, ARM64 had only the C loop).
+ * Sample by sample the recurrence cannot be vectorized: each output depends
+ * on the previous `order` outputs.  Four outputs per step can: the part of
+ * each of the four sums that uses samples from before the group is a dot
+ * product over known values, built with one lane per output, and a short
+ * serial tail adds the terms that use the group's own outputs.  2.85x the
+ * unrolled C loop on an Apple M2 at order 12, bit-identical (the sums are
+ * modular 32-bit either way, so their grouping does not matter).
+ */
+#if defined FLAC__CPU_ARM64 && FLAC__HAS_NEONINTRIN && !defined FLAC__NO_ASM && !defined FLAC__OVERFLOW_DETECT
+#include <arm_neon.h>
+#define FLAC__LPC_RESTORE_NEON 1
+
+static void lpc_restore_signal_neon12_(const FLAC__int32 * flac_restrict residual, uint32_t data_len, const FLAC__int32 * flac_restrict qlp_coeff, uint32_t order, int lp_quantization, FLAC__int32 * flac_restrict data)
+{
+	int32x4_t cv[12];
+	int32_t c[12];
+	int i, k, m;
+	const int n = (int)data_len;
+
+	for(k = 0; k < 12; k++)
+		c[k] = k < (int)order ? qlp_coeff[k] : 0;
+	/* cv[k]: the coefficients history value data[i-12+k] meets in outputs i..i+3:
+	 * output i+m reads it as data[(i+m)-1-j] with j = 11-k+m, zero past the order */
+	for(k = 0; k < 12; k++) {
+		int32_t lanes[4];
+		for(m = 0; m < 4; m++)
+			lanes[m] = 11 - k + m <= 11 ? c[11 - k + m] : 0;
+		cv[k] = vld1q_s32(lanes);
+	}
+	/* The first 12-order outputs would read before the warm-up samples: scalar */
+	for(i = 0; i < 12 - (int)order && i < n; i++) {
+		FLAC__int32 sum = 0;
+		int j;
+		for(j = 0; j < (int)order; j++)
+			sum += qlp_coeff[j] * data[i-j-1];
+		data[i] = residual[i] + (sum >> lp_quantization);
+	}
+	for(; i + 4 <= n; i += 4) {
+		const FLAC__int32 *h = data + i - 12;
+		int32x4_t s = vmulq_s32(cv[0], vdupq_n_s32(h[0]));
+		s = vmlaq_s32(s, cv[1], vdupq_n_s32(h[1]));
+		s = vmlaq_s32(s, cv[2], vdupq_n_s32(h[2]));
+		s = vmlaq_s32(s, cv[3], vdupq_n_s32(h[3]));
+		s = vmlaq_s32(s, cv[4], vdupq_n_s32(h[4]));
+		s = vmlaq_s32(s, cv[5], vdupq_n_s32(h[5]));
+		s = vmlaq_s32(s, cv[6], vdupq_n_s32(h[6]));
+		s = vmlaq_s32(s, cv[7], vdupq_n_s32(h[7]));
+		s = vmlaq_s32(s, cv[8], vdupq_n_s32(h[8]));
+		s = vmlaq_s32(s, cv[9], vdupq_n_s32(h[9]));
+		s = vmlaq_s32(s, cv[10], vdupq_n_s32(h[10]));
+		s = vmlaq_s32(s, cv[11], vdupq_n_s32(h[11]));
+		{
+			const FLAC__int32 s0 = vgetq_lane_s32(s, 0), s1 = vgetq_lane_s32(s, 1), s2 = vgetq_lane_s32(s, 2), s3 = vgetq_lane_s32(s, 3);
+			const FLAC__int32 o0 = residual[i] + (s0 >> lp_quantization);
+			const FLAC__int32 o1 = residual[i+1] + ((s1 + c[0] * o0) >> lp_quantization);
+			const FLAC__int32 o2 = residual[i+2] + ((s2 + c[1] * o0 + c[0] * o1) >> lp_quantization);
+			const FLAC__int32 o3 = residual[i+3] + ((s3 + c[2] * o0 + c[1] * o1 + c[0] * o2) >> lp_quantization);
+			data[i] = o0; data[i+1] = o1; data[i+2] = o2; data[i+3] = o3;
+		}
+	}
+	for(; i < n; i++) {
+		FLAC__int32 sum = 0;
+		int j;
+		for(j = 0; j < (int)order; j++)
+			sum += qlp_coeff[j] * data[i-j-1];
+		data[i] = residual[i] + (sum >> lp_quantization);
+	}
+}
+#endif
+
 #if !defined(NDEBUG) || defined FLAC__OVERFLOW_DETECT || defined FLAC__OVERFLOW_DETECT_VERBOSE
 #include <stdio.h>
 #endif
@@ -1023,6 +1095,13 @@
 	FLAC__ASSERT(order > 0);
 	FLAC__ASSERT(order <= 32);
 
+#ifdef FLAC__LPC_RESTORE_NEON
+	if(order <= 12) {
+		lpc_restore_signal_neon12_(residual, data_len, qlp_coeff, order, lp_quantization, data);
+		return;
+	}
+#endif
