#version 450

// This shader should be invoked with global invocation ids
// from (0, 0) until (MUSE_Y_BUF_WIDTH, MUSE_BUF_HEIGHT).
//
// Filters the chroma information in place.
// The is_red flag tells whether to filter the R och B color information -- the difference is
// that the first red signal is on rows 0 and 1, while the first blue signal is on rows 2 and 3.
// The phase input says whether the first two rows of information are aligned to the left (1)
// or top the right (0).
// If filter_stage is 0, the rows containing color informatation (2 out of 4 rows) are filtered
// horizontally.  If filter_stage is 1, the other two rows are filled in.

#include "muse.h"

// Low-pass filter with cutoff frequency 0.2 Hz, transition bandwith 0.05 Hz, rectangular window (from fiiir.com).
// We really only use half of the coefficients but the whole filter is included for simplicity.
#define HORIZ_FILTER_SIZE 63
float16_t filter_coeffs[HORIZ_FILTER_SIZE] = {
0.000780916776897215hf,
-0.000000000000000001hf,
-0.000933028269872013hf,
-0.000675249874195993hf,
0.000812356791573653hf,
0.001603814308324245hf,
-0.000000000000000003hf,
-0.002407871131369289hf,
-0.001813895687479526hf,
0.002196904425984004hf,
0.004275042070536313hf,
-0.000000000000000005hf,
-0.006055920772694355hf,
-0.004412639081075587hf,
0.005174337929885570hf,
0.009772284469869795hf,
-0.000000000000000009hf,
-0.013177524446737816hf,
-0.009427265637540537hf,
0.010905785350338036hf,
0.020428091240915765hf,
-0.000000000000000012hf,
-0.027623446493709555hf,
-0.020032794491919834hf,
0.023752349707743797hf,
0.046275967677881696hf,
-0.000000000000000015hf,
-0.072831076709504755hf,
-0.061024986756633315hf,
0.092629652216635383hf,
0.301891068993472456hf,
0.399834254785349286hf,
